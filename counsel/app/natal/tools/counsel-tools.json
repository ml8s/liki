{
  "version": "2026.09.25.0",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "compute_factors",
        "description": "engine 排盘结果（chart）→ 因子快照 {factors, factors_digest, context}。内部调 engine fullchart 取因子字段后求值；digest 为 SHA-256 canonical 防篡改校验。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chart"
          ],
          "properties": {
            "chart": {
              "type": "object",
              "description": "engine 排盘结果：本域 bazi_chart（八字）或 ziwei_chart（紫微）输出"
            }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "natal_query",
        "description": "已绑定来源的因子快照 + 人生问题 → 本命断语。context 必须原样来自 compute_factors，并与因子 provenance 校验。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factors",
            "factors_digest",
            "topics",
            "context"
          ],
          "properties": {
            "factors": {
              "type": "object",
              "description": "compute_factors 返回的因子快照"
            },
            "factors_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "compute_factors 返回的 SHA-256 因子摘要；必须与 factors 原样匹配"
            },
            "topics": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "marriage",
                  "family",
                  "children",
                  "career",
                  "wealth",
                  "health",
                  "mental",
                  "study",
                  "personality",
                  "appearance",
                  "origin",
                  "relocation",
                  "social",
                  "property",
                  "adversity",
                  "chart_structure"
                ],
                "description": "受控人生问题领域闭集"
              },
              "description": "人生问题域：marriage/family/children/career/wealth/health/mental/study/personality/appearance/origin/relocation/social/property/adversity/chart_structure 等"
            },
            "context": {
              "type": "object",
              "description": "compute_factors 返回的原始 context；会与因子 provenance 绑定校验"
            }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "period_query",
        "description": "因子快照 + 时间层 + 人生问题 → 应期断语（大运/大限/流年）。内部据 chart 调 engine 流年/大限取应期字段后匹配断语表。",
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "factors",
            "factors_digest",
            "time_scope",
            "topics",
            "chart"
          ],
          "properties": {
            "factors": {
              "type": "object",
              "description": "compute_factors 返回的因子快照"
            },
            "factors_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "compute_factors 返回的 SHA-256 因子摘要；必须与 factors 原样匹配"
            },
            "time_scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "year",
                    "year_range",
                    "current_year",
                    "decade",
                    "current_decade"
                  ]
                },
                "year": {
                  "type": "integer",
                  "description": "type=year/decade 时的锚定年份"
                },
                "start_year": {
                  "type": "integer",
                  "description": "type=year_range 的起始年份"
                },
                "end_year": {
                  "type": "integer",
                  "description": "type=year_range 的结束年份"
                }
              },
              "description": "时间层：year/year_range/current_year/decade/current_decade"
            },
            "topics": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "marriage",
                  "family",
                  "children",
                  "career",
                  "wealth",
                  "health",
                  "mental",
                  "study",
                  "personality",
                  "appearance",
                  "origin",
                  "relocation",
                  "social",
                  "property",
                  "adversity",
                  "chart_structure"
                ],
                "description": "受控人生问题领域闭集"
              },
              "description": "人生问题域（同 natal_query）"
            },
            "chart": {
              "type": "object",
              "description": "engine 排盘结果（同 compute_factors 输入），内部据此调 engine 流年/大限"
            }
          }
        }
      }
    }
  ]
}

            "op": "eq",
            "value": "壬多必取戊制"
          },
          {
            "path": "tiaohou_secondary_present",
            "op": "eq",
            "value": true
          },
          {
            "path": "wuxing_count.水",
            "op": "gte",
            "value": 3
          }
        ]
      },
      "set": {
        "tiaohou_secondary_condition_ok": true
      }
    },
    {
      "id": "tiaohou_yong",
      "when": {
        "const": true
      },
      "set": {
        "tiaohou_yong_source": {
          "$if": {
            "when": {
              "path": "tiaohou_primary_present",
              "op": "eq",
              "value": true
            },
            "then": {
              "$if": {
                "when": {
                  "path": "tiaohou_primary_visible",
                  "op": "eq",
                  "value": true
                },
                "then": "primary",
                "else": "primary_hidden"
              }
            },
            "else": {
              "$if": {
                "when": {
                  "all": [
                    {
                      "path": "tiaohou_secondary_present",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "path": "tiaohou_secondary_condition_ok",
                      "op": "eq",
                      "value": true
                    }
                  ]
                },
                "then": {
                  "$if": {
                    "when": {
                      "path": "tiaohou_secondary_visible",
                      "op": "eq",
                      "value": true
                    },
                    "then": "secondary",
                    "else": "secondary_hidden"
                  }
                },
                "else": {
                  "$if": {
                    "when": {
                      "path": "tiao_hou.primary_wuxing",
                      "op": "exists"
                    },
                    "then": "needed_primary",
                    "else": "none"
                  }
                }
              }
            }
          }
        },
        "tiaohou_yong_present": {
          "$if": {
            "when": {
              "path": "tiaohou_primary_present",
              "op": "eq",
              "value": true
            },
            "then": true,
            "else": {
              "$if": {
                "when": {
                  "all": [
                    {
                      "path": "tiaohou_secondary_present",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "path": "tiaohou_secondary_condition_ok",
                      "op": "eq",
                      "value": true
                    }
                  ]
                },
                "then": true,
                "else": false
              }
            }
          }
        },
        "tiaohou_yong_visible": {
          "$if": {
            "when": {
              "path": "tiaohou_primary_present",
              "op": "eq",
              "value": true
            },
            "then": {
              "$path": "tiaohou_primary_visible"
            },
            "else": {
              "$if": {
                "when": {
                  "all": [
                    {
                      "path": "tiaohou_secondary_present",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "path": "tiaohou_secondary_condition_ok",
                      "op": "eq",
                      "value": true
                    }
                  ]
                },
                "then": {
                  "$path": "tiaohou_secondary_visible"
                },
                "else": false
              }
            }
          }
        },
        "tiaohou_yong": {
          "$if": {
            "when": {
              "path": "tiaohou_primary_present",
              "op": "eq",
              "value": true
            },
            "then": {
              "$path": "tiao_hou.primary_wuxing"
            },
            "else": {
              "$if": {
                "when": {
                  "all": [
                    {
                      "path": "tiaohou_secondary_present",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "path": "tiaohou_secondary_condition_ok",
                      "op": "eq",
                      "value": true
                    }
                  ]
                },
                "then": {
                  "$path": "tiao_hou.secondary_wuxing"
                },
                "else": {
                  "$path": "tiao_hou.primary_wuxing"
                }
              }
            }
          }
        },
        "tiaohou_control_wuxing": {
          "$if": {
            "when": {
              "all": [
                {
                  "path": "tiao_hou.secondary_condition",
                  "op": "eq",
                  "value": "无壬用己；水多用戊制"
                },
                {
                  "path": "tiaohou_primary_present",
                  "op": "eq",
                  "value": true
                },
                {
                  "path": "wuxing_count.水",
                  "op": "gte",
                  "value": 3
                }
              ]
            },
            "then": "土",
            "else": ""
          }
        }
      }
    },
    {
      "id": "tiaohou_secondary_usable",
      "when": {
        "const": true
      },
      "set": {
        "tiaohou_secondary_usable": {
          "$if": {
            "when": {
              "all": [
                {
                  "path": "tiaohou_secondary_present",
                  "op": "eq",
                  "value": true
                },
                {
                  "path": "tiaohou_secondary_visible",
                  "op": "eq",
                  "value": true
                },
                {
                  "path": "tiaohou_secondary_condition_ok",
                  "op": "eq",
                  "value": true
                },
                {
                  "path": "tiaohou_secondary_supports_yong",
                  "op": "eq",
                  "value": true
                }
              ]
            },
            "then": true,
            "else": false
          }
        }
      }
    },
    {
      "id": "tiaohou_secondary_supports_yong",
      "when": {
        "const": true
      },
      "set": {
        "tiaohou_secondary_generates_yong": {
          "$eq_paths": [
            {
              "$lookup": {
                "table": "wuxing_relations",
                "key": {
                  "$path": "tiao_hou.secondary_wuxing"
                },
                "field": "generates"
              }
            },
            {
              "$path": "tiaohou_yong"
            }
          ]
        },
        "tiaohou_secondary_same_yong": {
          "$eq_paths": [
            {
              "$path": "tiao_hou.secondary_wuxing"
            },
            {
              "$path": "tiaohou_yong"
            }
          ]
        },
        "tiaohou_secondary_controls_yong": {
          "$eq_paths": [
            {
              "$lookup": {
                "table": "wuxing_relations",
                "key": {
                  "$path": "tiao_hou.secondary_wuxing"
                },
                "field": "controls"
              }
            },
            {
              "$path": "tiaohou_yong"
            }
          ]
        },
        "tiaohou_secondary_overstrong": {
          "$select_exists": {
            "from": "element_states",
            "where": {
              "all": [
                {
                  "path": "item.wuxing",
                  "op": "eq",
                  "value": {
                    "$path": "global.tiao_hou.secondary_wuxing"
                  }
                },
                {
                  "path": "item.strength",
                  "op": "eq",
                  "value": "strong"
                },
                {
                  "path": "item.season",
                  "op": "eq",
                  "value": "旺"
                }
              ]
            }
          }
        },
        "tiaohou_secondary_supports_yong": {
          "$if": {
            "when": {
              "all": [
                {
                  "path": "tiaohou_secondary_present",
                  "op": "eq",
                  "value": true
                },
                {
                  "path": "tiaohou_yong",
                  "op": "exists"
                },
                {
                  "any": [
                    {
                      "path": "tiaohou_secondary_generates_yong",
                      "op": "eq",
                      "value": true
                    },
                    {
                      "path": "tiaohou_secondary_same_yong",
                      "op": "eq",
                      "value": true
                    }
                  ]
                },
                {
                  "path": "tiaohou_secondary_controls_yong",
                  "op": "eq",
                  "value": false
                },
                {
                  "path": "tiaohou_secondary_overstrong",
                  "op": "eq",
                  "value": false
                }
              ]
            },
            "then": true,
            "else": false
          }
        }
      }
    },
    {
      "id": "tiaohou_xi",
      "when": {
        "const": true
      },
      "set": {
        "tiaohou_xi": {
          "$if": {
            "when": {
              "path": "tiaohou_secondary_usable",
              "op": "eq",
              "value": true
            },
            "then": {
              "$as_list": {
                "$path": "tiao_hou.secondary_wuxing"
              }
            },
            "else": []
          }
        }
      }
    },
    {
      "id": "neutral_overstrong",
      "when": {
        "const": true
      },
      "set": {
        "neutral_overstrong": {
          "$select": {
            "from": "element_states",
            "where": {
              "all": [
                {
                  "path": "item.strength",
                  "op": "eq",
                  "value": "strong"
                },
                {
                  "path": "item.season",
                  "op": "eq",
                  "value": "旺"
                }
              ]
            },
            "order_by": "item.count",
            "direction": "desc",
            "field": "item.wuxing"
          }
        }
      }
    },
    {
      "id": "neutral_overstrong_yong",
      "when": {
        "const": true
      },
      "set": {
        "neutral_overstrong_yong": {
          "$if": {
            "when": {
              "path": "neutral_overstrong.unique",
              "op": "eq",
              "value": true
            },
            "then": {
              "$lookup": {
                "table": "wuxing_relations",
                "key": {
                  "$path": "neutral_overstrong.value"
                },
                "field": "generates"
              }
            },
            "else": ""
          }
        }
      }
    },
    {
      "id": "neutral_weak",
      "when": {
        "const": true
      },
      "set": {
        "neutral_weak": {
          "$select": {
            "from": "element_states",
            "where": {
              "all": [
                {
                  "path": "item.strength",
                  "op": "in",
                  "value": [
                    "weak",
                    "neutral"
                  ]
                },
                {
                  "path": "item.controller_strength",
                  "op": "ne",
                  "value": "strong"
                }
              ]
            },
            "order_by": "item.count",
            "direction": "asc",
            "field": "item.wuxing"
          }
        }
      }
    },
    {
      "id": "neutral_weak_yong",
      "when": {
        "const": true
      },
      "set": {
        "neutral_weak_yong": {
          "$if": {
            "when": {
              "path": "neutral_weak.unique",
              "op": "eq",
              "value": true
            },
            "then": {
              "$path": "neutral_weak.value"
            },
            "else": ""
          }
        }
      }
    },
    {
      "id": "neutral_yong",
      "when": {
        "const": true
      },
      "set": {
        "neutral_yong": {
          "$if": {
            "when": {
              "path": "neutral_overstrong_yong",
              "op": "exists"
            },
            "then": {
              "$path": "neutral_overstrong_yong"
            },
            "else": {
              "$path": "neutral_weak_yong"
            }
          }
        },
        "neutral_status": {
          "$if": {
            "when": {
              "any": [
                {
                  "path": "neutral_overstrong_yong",
                  "op": "exists"
                },
                {
                  "path": "neutral_weak_yong",
                  "op": "exists"
                }
              ]
            },
            "then": "resolved",
            "else": {
              "$if": {
                "when": {
                  "any": [
                    {
                      "path": "neutral_overstrong.count",
                      "op": "gt",
                      "value": 0
                    },
                    {
                      "path": "neutral_weak.count",
                      "op": "gt",
                      "value": 0
                    }
                  ]
                },
                "then": "needs_review",
                "else": "unresolved"
              }
            }
          }
        }
      }
    },
    {
      "id": "neutral_xi_ji",
      "when": {
        "const": true
      },
      "set": {
        "neutral_xi": {
          "$if": {
            "when": {
              "path": "neutral_yong",
              "op": "exists"
            },
            "then": {
              "$list": [
                {
                  "$lookup": {
                    "table": "wuxing_relations",
                    "key": {
                      "$path": "neutral_yong"
                    },
                    "field": "generated_by"
                  }
                },
                {
                  "$path": "neutral_yong"
                }
              ]
            },
            "else": []
          }
        },
        "neutral_ji": {
          "$if": {
            "when": {
              "path": "neutral_yong",
              "op": "exists"
            },
            "then": {
              "$list": [
                {
                  "$lookup": {
                    "table": "wuxing_relations",
                    "key": {
                      "$path": "neutral_yong"
                    },
                    "field": "controlled_by"
                  }
                },
                {
                  "$lookup": {
                    "table": "wuxing_relations",
                    "key": {
                      "$path": "neutral_yong"
                    },
                    "field": "generates"
                  }
                }
              ]
            },
            "else": []
          }
        }
      }
    },
    {
      "id": "tiaohou_conflict",
      "when": {
        "const": true
      },
      "set": {
        "tiaohou_conflict": {
          "$if": {
            "when": {
              "all": [
                {
                  "path": "tiaohou_yong",
                  "op": "exists"
                },
                {
                  "path": "fu_yi.ji",
                  "op": "exists"
                },
                {
                  "$eq_paths": [
                    {
                      "$path": "tiaohou_yong"
                    },
                    {
                      "$path": "fu_yi.ji"
                    }
                  ]
                }
              ]
            },
            "then": true,
            "else": false
          }
        }
      }
    }
  ],
  "rules": [
    {
      "id": "YS-CG-FAKE",
      "when": {
        "path": "congge_fake",
        "op": "eq",
        "value": true
      },
      "then": {
        "selected.yong": "无候选",
        "selected.xi": [],
        "selected.ji": [],
        "source": "cong_ge",
        "status": "needs_review",
        "conflicts": [
          {
            "code": "fake_cong",
            "message": "假从格须结合大运与三得复核，静态盘不强行选定"
          }
        ]
      },
      "order": 10
    },
    {
      "id": "YS-CG-VERIFIED",
      "when": {
        "all": [
          {
            "path": "congge_pattern_present",
            "op": "eq",
            "value": true
          },
          {
            "path": "congge_verified",
            "op": "eq",
            "value": true
          }
        ]
      },
      "then": {
        "selected.yong": {
          "$path": "fu_yi.yong"
        },
        "selected.xi": {
          "$as_list": {
            "$path": "fu_yi.xi"
          }
        },
        "selected.ji": {
          "$as_list": {
            "$path": "fu_yi.ji"
          }
        },
        "source": "cong_ge",
        "status": "resolved",
        "conflicts": []
      },
      "order": 11
    },
    {
      "id": "YS-CG-UNVERIFIED",
      "when": {
        "all": [
          {
            "path": "congge_pattern_present",
            "op": "eq",
            "value": true
          },
          {
            "path": "congge_verified",
            "op": "eq",
            "value": false
          }
        ]
      },
      "then": {
        "selected.yong": "无候选",
        "selected.xi": [],
        "selected.ji": [],
        "source": "cong_ge",
        "status": "needs_review",
        "conflicts": [
          {
            "code": "congge_unverified",
            "message": "从格标签未通过表内双证复核"
          }
        ]
      },
      "order": 12
    },
    {
      "id": "YS-TH-CONFLICT",
      "when": {
        "all": [
          {
            "path": "season_is_extreme",
            "op": "eq",
            "value": true
          },
          {
            "path": "tiaohou_yong",
            "op": "exists"
          },
          {
            "path": "tiaohou_conflict",
            "op": "eq",
            "value": true
          }
        ]
      },
      "then": {
        "selected.yong": "无候选",
        "selected.xi": [],
        "selected.ji": [],
        "source": "tiao_hou",
        "status": "needs_review",
        "conflicts": [
          {
            "code": "tiaohou_fuyi_conflict",
            "message": "调候用神与扶抑忌神直接相反，不硬判"
          }
        ]
      },
      "order": 20
    },
    {
      "id": "YS-TH",
      "when": {
        "all": [
          {
            "path": "season_is_extreme",
            "op": "eq",
            "value": true
          },
          {
            "path": "tiaohou_yong",
            "op": "exists"
          }
        ]
      },
      "then": {
        "selected.yong": {
          "$path": "tiaohou_yong"
        },
        "selected.xi": {
          "$path": "tiaohou_xi"
        },
        "selected.ji": {
          "$as_list": {
            "$path": "fu_yi.ji"
          }
        },
        "source": "tiao_hou",
        "status": {
          "$if": {
            "when": {
              "path": "tiaohou_yong_visible",
              "op": "eq",
              "value": true
            },
            "then": "resolved",
            "else": "partial"
          }
        },
        "conflicts": {
          "$if": {
            "when": {
              "path": "tiaohou_yong_present",
              "op": "eq",
              "value": false
            },
            "then": [
              {
                "code": "tiaohou_evidence_missing",
                "message": "调候主辅神均未在原局落实，仅保留所需五行，不作强断"
              }
            ],
            "else": {
              "$if": {
                "when": {
                  "path": "tiaohou_yong_visible",
                  "op": "eq",
                  "value": false
                },
                "then": [
                  {
                    "code": "tiaohou_evidence_hidden",
                    "message": "调候用神仅在藏支出现，未透干，按部分落实处理"
                  }
                ],
                "else": []
              }
            }
          }
        }
      },
      "order": 21
    },
    {
      "id": "YS-FUYI",
      "when": {
        "path": "fu_yi.yong",
        "op": "exists"
      },
      "then": {
        "selected.yong": {
          "$path": "fu_yi.yong"
        },
        "selected.xi": {
          "$as_list": {
            "$path": "fu_yi.xi"
          }
        },
        "selected.ji": {
          "$as_list": {
            "$path": "fu_yi.ji"
          }
        },
        "source": "fu_yi",
        "status": "resolved"
      },
      "order": 32
    },
    {
      "id": "YS-NEUTRAL-TH",
      "when": {
        "all": [
          {
            "path": "neutral_yong",
            "op": "exists"
          },
          {
            "path": "tiaohou_yong",
            "op": "exists"
          },
          {
            "path": "tiaohou_yong_present",
            "op": "eq",
            "value": true
          },
          {
            "$eq_paths": [
              {
                "$path": "neutral_yong"
              },
              {
                "$path": "tiaohou_yong"
              }
            ]
          }
        ]
      },
      "then": {
        "selected.yong": {
          "$path": "neutral_yong"
        },
        "selected.xi": {
          "$union": [
            {
              "$path": "neutral_xi"
            },
            {
              "$path": "tiaohou_xi"
            }
          ]
        },
        "selected.ji": {
          "$path": "neutral_ji"
        },
        "source": "neutral_fallback+tiao_hou",
        "status": {
          "$path": "neutral_status"
        }
      },
      "order": 39
    },
    {
      "id": "YS-NEUTRAL",
      "when": {
        "path": "neutral_yong",
        "op": "exists"
      },
      "then": {
        "selected.yong": {
          "$path": "neutral_yong"
        },
        "selected.xi": {
          "$path": "neutral_xi"
        },
        "selected.ji": {
          "$path": "neutral_ji"
        },
        "source": "neutral_fallback",
        "status": {
          "$path": "neutral_status"
        }
      },
      "order": 40
    },
    {
      "id": "YS-NEUTRAL-REVIEW",
      "when": {
        "path": "neutral_status",
        "op": "eq",
        "value": "needs_review"
      },
      "then": {
        "selected.yong": "无候选",
        "selected.xi": [],
        "selected.ji": [],
        "source": "neutral_fallback",
        "status": "needs_review",
        "conflicts": [
          {
            "code": "neutral_tie",
            "message": "中和取用存在多个同权候选，需人工复核"
          }
        ]
      },
      "order": 41
    },
    {
      "id": "YS-UNRESOLVED",
      "when": {
        "const": true
      },
      "then": {
        "selected.yong": "无候选",
        "selected.xi": [],
        "selected.ji": [],
        "source": "none",
        "status": "unresolved",
        "conflicts": [
          {
            "code": "no_candidate",
            "message": "扶抑、调候、从格均未给出可用候选"
          }
        ]
      },
      "order": 50
    }
  ],
  "finalize": {
    "disjoint": {
      "yong_vs_xi_ji": {
        "on_overlap": {
          "remove_from": [
            "xi",
            "ji"
          ],
          "status": "needs_review",
          "conflict": {
            "code": "yong_overlap",
            "message": "用神同时出现在喜神/忌神，候选冲突"
          }
        }
      },
      "xi_vs_ji": {
        "on_overlap": {
          "remove_from": [
            "xi",
            "ji"
          ],
          "status": "needs_review",
          "conflict": {
            "code": "xi_ji_overlap",
            "message": "喜神与忌神重叠，不能硬套喜忌"
          }
        }
      }
    },
    "missing_fields": {
      "on_missing": {
        "status": "partial"
      }
    }
  }
}

    {
      "id": "congge_pattern_present",
      "when": {
        "const": true
      },
      "set": {
        "congge_pattern_present": {
          "$if": {
            "when": {
              "path": "fu_yi.pattern",
              "op": "contains",
              "value": "从"
            },
            "then": true,
            "else": false
          }
        },
        "congge_fake": {
          "$if": {
            "when": {
              "path": "fu_yi.pattern",
              "op": "contains",
              "value": "假从"
            },
            "then": true,
            "else": false
          }
        }
      }
    },
    {
      "id": "congge_verified_cong_wang",
      "when": {
        "all": [
          {
            "path": "fu_yi.pattern",
            "op": "eq",
            "value": "从旺格"
          },
          {
            "path": "fu_yi.basis.season",
            "op": "in",
            "value": [
              "旺",
              "相"
            ]
          },
          {
            "path": "fu_yi.basis.yin_bi_count",
            "op": "gte",
            "value": 3
          },
          {
            "path": "guan_sha_effective_count",
            "op": "eq",
            "value": 0
          },
          {
            "path": "cai_effective_count",
            "op": "eq",
            "value": 0
          },
          {
            "path": "shi_shang_effective_count",
            "op": "eq",
            "value": 0
          }
        ]
      },
      "set": {
        "congge_verified": true
      }
    },

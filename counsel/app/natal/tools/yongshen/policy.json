  "pre_factors": [
    {
      "id": "season_is_extreme",
      "when": {
        "const": true
      },
      "set": {
        "season_is_extreme": {
          "$if": {
            "when": {
              "path": "month_zhi",
              "op": "in",
              "value": {
                "$table": "extreme_months"
              }
            },
            "then": true,
            "else": false
          }
        }
      }
    },
    {
      "id": "ge_ju_clear",
      "when": {
        "const": true
      },
      "set": {
        "ge_ju_clear": {
          "$if": {
            "when": {
              "path": "ge_ju.pattern_god_source",
              "op": "eq",
              "value": "main_qi"
            },
            "then": true,
            "else": false
          }
        }
      }
    },
    {
      "id": "tiaohou_primary_present",
      "when": {
        "const": true
      },
      "set": {
        "tiaohou_primary_present": {
          "$if": {
            "when": {
              "path": "tiao_hou.primary.occurrences",
              "op": "length_gt",
              "value": 0
            },
            "then": true,
            "else": false
          }
        }
      }
    },
    {
      "id": "tiaohou_primary_visible",
      "when": {
        "const": true
      },
      "set": {
        "tiaohou_primary_visible": {
          "$if": {
            "when": {
              "path": "tiao_hou.primary.transparent",
              "op": "eq",
              "value": true
            },
            "then": true,
            "else": false
          }
        }
      }
    },
    {
      "id": "tiaohou_secondary_present",
      "when": {
        "const": true
      },
      "set": {
        "tiaohou_secondary_present": {
          "$if": {
            "when": {
              "all": [
                {
                  "path": "tiao_hou.secondary_wuxing",
                  "op": "exists"
                },
                {
                  "path": "tiao_hou.secondary.occurrences",
                  "op": "length_gt",
                  "value": 0
                }
              ]
            },
            "then": true,
            "else": false
          }
        }
      }
    },
    {
      "id": "tiaohou_secondary_visible",

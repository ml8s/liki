# Liki counsel-mcp
# Required: engine-mcp endpoint (fail-fast at startup when empty).
LIKI_ENGINE_MCP_URL=http://engine-mcp:8081/mcp
# Bind host used by uvicorn; Caddy must be the only public edge.
LIKI_BIND_HOST=127.0.0.1
LIKI_ENGINE_MCP_TIMEOUT_SECONDS=30
# Bounded engine dependency check used by /readyz.
LIKI_READYZ_TIMEOUT_SECONDS=1
LIKI_ENGINE_MCP_MAX_RETRIES=2
# Idle seconds before a worker closes its outbound engine keep-alive connection.
LIKI_HTTP_IDLE_TIMEOUT_SECONDS=55

LIKI_HTTP_MAX_BODY_BYTES=1048576
# Runtime version reported by counsel; the image build injects it.
LIKI_VERSION=

# Liki counsel-mcp
# Required: engine-mcp endpoint (fail-fast at startup when empty).
LIKI_MCP_URL=http://engine-mcp:8081/mcp
LIKI_MCP_TIMEOUT=30
# Bounded engine dependency check used by /readyz.
LIKI_READYZ_TIMEOUT_SECONDS=1
LIKI_MCP_MAX_RETRIES=2
# Idle seconds before a worker closes its outbound engine keep-alive connection.
LIKI_MCP_HTTP_IDLE_TIMEOUT=55

# Optional bearer-token gate for self-hosted MCP requests.
LIKI_MCP_TOKEN=
# Outbound engine-mcp bearer; falls back to LIKI_MCP_TOKEN when empty.
LIKI_ENGINE_MCP_TOKEN=
LIKI_MCP_MAX_BODY_BYTES=1048576
# Runtime version reported by counsel; the image build injects it.
LIKI_VERSION=

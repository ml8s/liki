{
  "$schema": "https://json.schemastore.org/tools.json",
  "info": {
    "title": "liki Skill Tools — 规则引擎工具",
    "description": "liki skill 的 5 个规则引擎工具（排盘/因子生成/断语查询），OpenAI function calling 格式（tools 数组）。外部 agent（本地或 web）以此文件 + 引擎 rpc.discover 获取全部工具调用方法。执行：服务端 python3（tools/*.py 纯标准库）；web agent 经 agent_cli.py 分派。",
    "version": "3.9.0"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "full_paipan",
        "description": "排盘（本命）：一次排全八字+紫微，返回本命盘（含内嵌因子 fac）。时间精度未知默认 12:00；correct=true 走真太阳时校正（需经度），false 按题定时辰直接排。",
        "parameters": {
          "type": "object",
          "properties": {
            "time": {
              "type": "string",
              "format": "date-time",
              "description": "出生公历时间（RFC3339），未知时分默认 12:00"
            },
            "gender": {
              "type": "string",
              "enum": ["male", "female"],
              "description": "性别"
            },
            "longitude": {
              "type": "number",
              "description": "出生地经度（度），correct=true 时用于真太阳时校正；缺省东八区 120"
            },
            "correct": {
              "type": "boolean",
              "description": "true=按真太阳时校正（路 A：给具体时刻）；false=按题定时辰直接排（路 B）",
              "default": true
            }
          },
          "required": ["time", "gender"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "liunian",
        "description": "排盘（流年）：本命盘 + 年份 → 八字+紫微流年单年合并盘（应期按候选年逐调）。",
        "parameters": {
          "type": "object",
          "properties": {
            "pan": {
              "type": "object",
              "description": "本命盘（full_paipan 返回）"
            },
            "year": {
              "type": "integer",
              "description": "目标年份"
            }
          },
          "required": ["pan", "year"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "make_factors",
        "description": "因子生成（本命）：本命盘 → 双盘因子快照 {八字, 紫微}（数据层真分开、一次返回）。",
        "parameters": {
          "type": "object",
          "properties": {
            "pan": {
              "type": "object",
              "description": "本命盘（full_paipan 返回，含 fac）"
            }
          },
          "required": ["pan"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "make_liunian_factors",
        "description": "因子生成（流年）：本命盘 + 流年盘 → 双盘流年因子快照 {八字, 紫微}。",
        "parameters": {
          "type": "object",
          "properties": {
            "pan": {
              "type": "object",
              "description": "本命盘（full_paipan 返回）"
            },
            "liunian_pan": {
              "type": "object",
              "description": "流年盘（liunian 返回）"
            },
            "target": {
              "type": "string",
              "description": "目标星/主题，默认 配偶星",
              "default": "配偶星"
            },
            "year": {
              "type": "integer",
              "description": "目标年份",
              "default": 0
            }
          },
          "required": ["pan", "liunian_pan"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "query",
        "description": "断语查询：域 + 双盘因子快照 → 该域断语 {八字: [...], 紫微: [...]}（内部真值表匹配）。rule ∈ 本命 19 域 + 流年域 yearly_*。",
        "parameters": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "enum": ["xueye", "marriage", "shiye", "chushen", "caiyun", "jiankang", "xingge", "liuqin", "waimao", "shensha", "geju", "zuhe", "ziwei", "tiaohou", "dayun", "tianzhai", "qianyi", "zinv", "zhiye", "yingqi", "yearly_marriage", "yearly_liuqin", "yearly_caiyun", "yearly_shiye", "yearly_jiankang", "yearly_xueye", "yearly_zinv"],
              "description": "断语域（本命 19 域 + 流年 yearly_*）"
            },
            "snapshots": {
              "type": "object",
              "description": "双盘因子快照（make_factors / make_liunian_factors 返回）"
            }
          },
          "required": ["rule", "snapshots"]
        }
      }
    }
  ]
}

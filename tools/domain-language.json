      "id": "instant",
      "owner": "engine/internal/engine/tianwen",
      "definition": "内部天文学使用的绝对时间点；不是公开 MCP wire 字段。",
      "surfaces": {
        "go": "time.Time",
        "python": "datetime.datetime",
        "json": "(internal)",
        "zh_cn": "内部精确时刻"
      },
      "representation": "Internal only: an astronomical event instant or `standard.UTC()`; public tools expose `standard_time`.",
      "verbs": {
        "to_utc": "UTC"
      },
      "related": [
        "standard_time",
        "zone"
      ],
      "status": "canonical",
      "forbidden": [
        "timestamp",
        "time_point",
        "utc_time"
      ],
      "compatibility": []
    },

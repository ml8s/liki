{
  "schema_version": "liuyao-condition-rules-v1",
  "conclusion_scope": "conditional_rule_restoration_not_absolute_verdict",
  "state_classes": {
    "strong": {
      "path": "focus.yong_shen.wang_shuai",
      "values": [
        "旺",
        "相"
      ]
    },
    "weak": {
      "path": "focus.yong_shen.wang_shuai",
      "values": [
        "休",
        "囚",
        "死"
      ]
    }
  },
  "rules": [
    {
      "id": "month-break-not-always-failed",
      "statement": "月破必废",
      "restored": "月破只在休囚静爻且无救应时，才作为真破 / 当下无力候选；旺相有救为假破候选。",
      "applies_if": {
        "focus.yong_shen.yue_po": true
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "旺相月破先作假破 / 先挫后成候选。",
        "requires": [
          "月日生扶或动爻救应",
          "不与其他真空真破叠加"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "休囚月破先作真破 / 当下无力候选。",
        "requires": [
          "静爻或失令",
          "无有效原神救应"
        ]
      },
      "forbidden": [
        "见月破直接断废",
        "以月破单独决定最终结果"
      ]
    },
    {
      "id": "void-not-always-useless",
      "statement": "旬空无用",
      "restored": "旬空须分真空 / 假空；旺相、发动、有救不作无用。",
      "applies_if": {
        "focus.yong_shen.xun_kong": true
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "旺相或发动旬空先作假空 / 迟成候选。",
        "requires": [
          "出空、填实或冲空的触发候选",
          "事项仍存在现实基础"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "休囚安静旬空先作真空 / 事不实候选。",
        "requires": [
          "无动爻生扶",
          "无冲空救应"
        ]
      },
      "forbidden": [
        "见旬空断无用",
        "把冲空一律解释为冲实"
      ]
    },
    {
      "id": "liuhe-not-always-success",
      "statement": "见六合必成",
      "restored": "六合只是聚 / 稳 / 缓结构，必须用神有气且世应能承接。",
      "applies_if": {
        "evidence.secondary[].fact.sub_type": "六合"
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "六合且用神旺相，可作事易聚 / 易稳候选。",
        "requires": [
          "用神不受真空真破压制",
          "世应或用神实际受益"
        ]
      },
      "weak_branch": {
        "status": "rejected",
        "conclusion": "用神无气时，六合不单独支持成事结论。"
      },
      "forbidden": [
        "见六合断吉",
        "把六合当作婚姻或合作已经成立"
      ]
    },
    {
      "id": "six-chong-not-always-failure",
      "statement": "见六冲必散",
      "restored": "六冲主反复、冲动或离散候选；旺相有救不一定败，衰而受冲才加重不利。",
      "applies_if": {
        "evidence.secondary[].fact.sub_type": "六冲"
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "六冲而用神有气，先作反复 / 波折候选。",
        "requires": [
          "月日或动爻有救应",
          "世爻能承受冲击"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "六冲且用神无气，作散 / 难成候选。",
        "requires": [
          "无原神救应",
          "世应不能承接"
        ]
      },
      "forbidden": [
        "见六冲断凶",
        "把六冲单独当作结果"
      ]
    },
    {
      "id": "brother-moving-not-certain-loss",
      "statement": "兄弟动必破财",
      "restored": "兄弟动是克财候选，必须实际作用到妻财且妻财无力。",
      "applies_if": {
        "evidence.primary[].fact.relation": "克用",
        "topic": "wealth"
      },
      "strong_branch": {
        "status": "rejected",
        "conclusion": "妻财旺相有气，兄弟动克用只作竞争或短期压力候选，不直接断破财。",
        "requires": [
          "是否有持续克制",
          "是否叠加坡绝或比劫夺财"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "兄弟动克到休囚妻财，作耗损 / 竞争压力候选。",
        "requires": [
          "兄弟爻旺衰",
          "是否有原神或救应",
          "世爻承受力弱"
        ]
      },
      "forbidden": [
        "只凭六亲名称断破财",
        "把竞争压力换算成金额"
      ]
    },
    {
      "id": "hidden-yong-shen-not-always-unavailable",
      "statement": "用神不现即无成",
      "restored": "用神伏藏须核对伏神旺衰、飞神压制与出伏条件；伏神有气只作迟成候选。",
      "applies_if": {
        "focus.yong_shen.is_hidden": true
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "伏神旺相或有生扶时，可作可出、迟成候选。",
        "requires": [
          "冲飞或值日的触发条件",
          "现实事项仍有基础"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "伏神休囚空破且无救时，才作难成或暂不实候选。",
        "requires": [
          "无动爻生扶",
          "无出伏触发"
        ]
      },
      "forbidden": [
        "见用神不现直接断无成",
        "把伏神出现等同于立即成功"
      ]
    },
    {
      "id": "moving-line-not-automatic-outcome",
      "statement": "动爻必然决定吉凶",
      "restored": "动爻只是引动源，须核对动爻六亲、旺衰、动变关系与是否实际作用用神。",
      "applies_if": {
        "focus.yong_line.flags.moving": true
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "旺相动爻实际生扶用神时，才作为有力引动。",
        "requires": [
          "动爻与用神的实际生克路径",
          "动变未化进化退或回头受损"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "休囚动爻或未作用用神时，只作扰动或拖延候选。",
        "requires": [
          "核对动爻旺衰",
          "核对动变结果"
        ]
      },
      "forbidden": [
        "见动爻即断吉凶",
        "不核对作用对象直接断应期"
      ]
    },
    {
      "id": "returning-control-not-absolute-damage",
      "statement": "回头克必废",
      "restored": "回头克是变爻回克动爻的结构；是否废用须核动爻旺衰、原神救应与所问事项。",
      "applies_if": {
        "facts.moving_transformations[].return_relation": "回头克"
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "动爻旺相且有原神救应时，回头克先作压力或调整候选。",
        "requires": [
          "动爻旺衰",
          "是否有生扶救应"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "动爻休囚空破且无救时，才作废用或严重受损候选。",
        "requires": [
          "无原神生扶",
          "现实事项可承受度"
        ]
      },
      "forbidden": [
        "见回头克直接断废",
        "忽略动爻旺衰"
      ]
    },
    {
      "id": "returning-support-not-automatic-success",
      "statement": "回头生必成",
      "restored": "回头生是变爻回生动爻的结构；仍须核动爻能否承接、是否空破以及世爻状态。",
      "applies_if": {
        "facts.moving_transformations[].return_relation": "回头生"
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "动爻旺相不空破且世爻能承接时，可作有力扶助候选。",
        "requires": [
          "动爻旺衰",
          "世应承接能力"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "动爻空破或世爻无力时，回头生只作迟缓扶助候选。",
        "requires": [
          "是否旬空月破",
          "是否有其他忌神压制"
        ]
      },
      "forbidden": [
        "见回头生直接断成",
        "忽略世爻与用神状态"
      ]
    },
    {
      "id": "complete-sanhe-is-candidate-not-verdict",
      "statement": "三合局一见即吉凶定论",
      "restored": "完整三合只是结构候选，须核动爻数量、目标爻是否入局、空破与五行旺衰。",
      "applies_if": {
        "facts.san_he_candidates[].complete": true
      },
      "strong_branch": {
        "status": "accepted",
        "conclusion": "局成且目标爻旺相不空破时，才作为强结构候选。",
        "requires": [
          "目标爻是否入局",
          "动爻与空破情况"
        ]
      },
      "weak_branch": {
        "status": "accepted",
        "conclusion": "目标爻空破或局力休囚时，只作弱结构或延迟候选。",
        "requires": [
          "空破与旺衰核对",
          "是否有冲破救应"
        ]
      },
      "forbidden": [
        "只凭三合结构断成败",
        "把结构候选写成必然事实"
      ]
    }
  ]
}

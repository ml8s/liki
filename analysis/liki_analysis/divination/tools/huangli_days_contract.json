{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liki:huangli-days-v2",
  "title": "黄历择日契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question",
    "event",
    "event_label",
    "range",
    "recommended",
    "unsuitable",
    "candidates",
    "policy",
    "safety_advisory"
  ],
  "properties": {
    "schema_version": {
      "const": "huangli-days-v2"
    },
    "question": {
      "type": "string"
    },
    "event": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date",
        "days"
      ],
      "properties": {
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "recommended": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "unsuitable": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_scope",
        "no_bazi_composite_without_birth_data",
        "no_guarantee"
      ],
      "properties": {
        "candidate_scope": {
          "const": "traditional_huangli_labels_only"
        },
        "no_bazi_composite_without_birth_data": {
          "const": true
        },
        "no_guarantee": {
          "const": true
        }
      }
    },
    "safety_advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blocking",
        "category",
        "severity",
        "support_first",
        "message",
        "guidance"
      ],
      "properties": {
        "status": {
          "enum": [
            "allow",
            "advisory"
          ]
        },
        "blocking": {
          "const": false
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "enum": [
            "none",
            "normal",
            "high"
          ]
        },
        "support_first": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "guidance": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "jian_chu",
        "suitability",
        "reason",
        "warnings",
        "day"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "jian_chu": {
          "type": [
            "string",
            "null"
          ]
        },
        "suitability": {
          "enum": [
            "recommended",
            "possible",
            "unsuitable",
            "unspecified"
          ]
        },
        "reason": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "day": {
          "type": "object"
        }
      }
    }
  }
}

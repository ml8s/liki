{
  "schema_version": "divination-safety-rules-v2",
  "message": "该问题涉及现实风险或专业决策；传统命理解读仅供参考，应结合专业意见和现实条件。",
  "rules": [
    {
      "category": "self_harm",
      "guidance": "如存在紧急风险，请先联系当地紧急服务、心理危机干预热线或可信赖的人。",
      "patterns": [
        "suicid(?:e|al)",
        "\\b(?:kill|hurt)\\s+(?:myself|my ?self)\\b",
        "self[- ]?harm",
        "\\bend\\s+(?:my|this)\\s+life\\b",
        "don'?t\\s+want\\s+to\\s+(?:live|be here)",
        "\\bno\\s+reason\\s+to\\s+live\\b",
        "自杀",
        "自残",
        "不想活",
        "活不下去",
        "轻生",
        "伤害自己"
      ]
    },
    {
      "category": "emergency_medical",
      "guidance": "请优先联系当地急救或医疗机构。",
      "patterns": [
        "\\b(?:overdose|cardiac arrest|unconscious|ambulance)\\b",
        "severe\\s+(?:bleeding|breathing difficulty|abdominal pain)",
        "can'?t\\s+breathe",
        "大出血",
        "呼吸困难",
        "昏迷",
        "失去意识",
        "剧烈腹痛",
        "急救",
        "救护车"
      ]
    },
    {
      "category": "serious_medical",
      "guidance": "医疗判断和治疗请咨询主治医生或医疗机构；卦象仅作传统文化参考。",
      "patterns": [
        "\\b(?:cancer|terminal illness|surgery|stop taking .* medication)\\b",
        "how long.*(?:live|survive)",
        "癌症",
        "重病",
        "手术",
        "能活多久",
        "生死",
        "确诊.*怎么治",
        "停药",
        "换药"
      ]
    },
    {
      "category": "pregnancy",
      "guidance": "孕产相关问题请咨询产科或医疗机构。",
      "patterns": [
        "\\b(?:pregnan(?:cy|t)|fetal sex|miscarriage)\\b",
        "怀孕",
        "胎儿",
        "保胎",
        "流产",
        "预产期",
        "胎儿性别"
      ]
    },
    {
      "category": "missing_person_safety",
      "guidance": "请同时联系警方或救援机构。",
      "patterns": [
        "\\b(?:kidnap(?:ped|ping)?|murder(?:ed|er)?)\\b",
        "下落不明.*生死",
        "被绑架",
        "凶手"
      ]
    },
    {
      "category": "domestic_violence",
      "guidance": "请优先保证人身安全，并联系当地反家暴援助、警方或专业支持机构。",
      "patterns": [
        "\\b(?:domestic violence|abusive (?:partner|husband|wife|parent))\\b",
        "家暴",
        "家庭暴力",
        "被打.*伴侣",
        "被打.*家人"
      ]
    },
    {
      "category": "major_financial_risk",
      "guidance": "请咨询持牌财务或法律专业人士，先评估止损和现实条件。",
      "patterns": [
        "\\ball\\s+(?:my|of my)\\s+(?:money|savings)\\b",
        "\\ball[- ]in\\b.*\\b(?:life savings|investment)\\b",
        "全部身家",
        "倾家荡产",
        "高利贷",
        "梭哈",
        "借.*全部.*投"
      ]
    },
    {
      "category": "criminal_risk",
      "guidance": "请咨询律师或联系有权处理机关。",
      "patterns": [
        "\\b(?:tax evasion|drug (?:deal|trafficking)|hurt (?:someone|people))\\b",
        "(?<!游戏)杀人",
        "犯罪",
        "逃税",
        "伤害他人",
        "毒品"
      ]
    }
  ]
}

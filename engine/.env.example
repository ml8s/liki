# Liki 命理引擎（engine-mcp，默认 :8081）
LIKI_HTTP_LISTEN_ADDRESS=:8081

# Comma-separated browser origins allowed by CORS. Leave empty for the hosted
# liki.hk default. Self-hosted web clients should set their exact HTTPS origin.
LIKI_ENGINE_ALLOWED_ORIGINS=

# Successful tool results: "structured" omits duplicate TextContent.

# Liki 命理引擎（engine-mcp；engine-rpc 过渡期默认 :8080）
LISTEN_ADDR=:8081

# Comma-separated browser origins allowed by CORS. Leave empty for the hosted
# liki.hk default. Self-hosted web clients should set their exact HTTPS origin.
LIKI_ALLOWED_ORIGINS=

# city_coords 未命中内置城市表时是否允许查询 Nominatim（OSM）。
# 设为 off 可禁止外部网络请求；调用方需直接提供经纬度。
LIKI_EXTERNAL_GEOCODING=on

# Optional bearer token for MCP requests. Leave empty for the public hosted
# service; set the same value on counsel-mcp for a private deployment.
LIKI_MCP_TOKEN=

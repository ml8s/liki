{
  "version": 1,
  "yi_ju": "TIME_MODEL projection matrix. Solar-term events decide 立春/节气; 命理 facts use standard local time: standard date, local astronomical lunar date, and local LAST shichen. Only astronomical events are global instants.",
  "cases": [
    {
      "name": "bazhai_before_lichun",
      "tool": "bazhai_chart",
      "input": {
        "subject": {
          "birth_time": "1984-01-20T12:00:00+08:00",
          "birth_longitude": 116.4,
          "gender": "male"
        }
      },
      "expect": {
        "ming_gua.gua.name": "艮",
        "ming_gua.group": "西四命",
        "ming_gua.year_boundary": "lichun",
        "birth_year_xing.year": 1983,
        "birth_year_xing.year_boundary": "lichun"
      }
    },
    {
      "name": "xuankong_2024_before_lichun",
      "tool": "xuankong_chart",
      "input": {
        "zhai": {
          "yun_start_time": "2024-02-04T12:00:00+08:00",
          "zuo_shan": 2,
          "xiang_shan": 14
        }
      },
      "expect": {
        "yun.year": 2023,
        "yun.yun_number": 8,
        "yun.year_boundary": "lichun"
      }
    },
    {
      "name": "xuankong_2024_after_lichun",
      "tool": "xuankong_chart",
      "input": {
        "zhai": {
          "yun_start_time": "2024-02-04T18:00:00+08:00",
          "zuo_shan": 2,
          "xiang_shan": 14
        }
      },
      "expect": {
        "yun.year": 2024,
        "yun.yun_number": 9,
        "yun.year_boundary": "lichun"
      }
    },
    {
      "name": "bazi_liuri_last_boundary",
      "tool": "bazi_liuri",
      "chart_from": "bazi_chart_liuri.json",
      "input": {
        "liu_ri_start_time": "2026-06-01T23:30:00+08:00",
        "liu_ri_count": 1,
        "liu_ri_longitude": 116.4
      },
      "expect": {
        "liu_ri.0.liu_ri_date": "2026-06-01",
        "liu_ri.0.ri_gan": "丙",
        "liu_ri.0.ri_zhi": "午",
        "liu_ri.0.ri_jie.liu_ri_local_date": "2026-06-01",
        "liu_ri.0.ri_jie.beijing_calendar_date": "2026-06-01",
        "liu_ri.0.ri_jie.liu_ri_solar_date": "2026-06-01"
      }
    },
    {
      "name": "ziwei_liuri_local_lunar",
      "tool": "ziwei_liuri",
      "chart_from": "ziwei_chart_liuri.json",
      "input": {
        "liu_ri_start_time": "2026-06-01T22:30:00-05:00",
        "liu_ri_count": 1
      },
      "expect": {
        "liu_ri.0.ri_jie.liu_ri_local_date": "2026-06-01",
        "liu_ri.0.ri_jie.beijing_calendar_date": "2026-06-02",
        "liu_ri.0.ri_jie.lunar.year": 2026,
        "liu_ri.0.ri_jie.lunar.month": 4,
        "liu_ri.0.ri_jie.lunar.day": 17,
        "liu_ri.0.ri_jie.lunar.leap": false
      }
    },
    {
      "name": "ziwei_liushi_last_shichen",
      "tool": "ziwei_liushi",
      "chart_from": "ziwei_chart_liushi.json",
      "input": {
        "liu_shi_start_time": "2026-06-01T22:30:00-05:00",
        "liu_shi_count": 1,
        "liu_shi_longitude": -74.0

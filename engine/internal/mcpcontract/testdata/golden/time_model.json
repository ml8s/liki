{
  "version": 1,
  "basis": "TIME_MODEL projection matrix. Absolute instant decides 立春/节气; all 命理 time facts use local time: local civil date, local astronomical lunar date, and local LAST shichen. Only astronomical events are global instants.",
  "cases": [
    {
      "name": "bazhai_before_lichun",
      "tool": "bazhai_chart",
      "input": {
        "gender": "male",
        "standard_time": "1984-01-20T12:00:00+08:00"
      },
      "expect": {
        "ming_gua.gua.name": "艮",
        "ming_gua.group": "西四命",
        "ming_gua.year_boundary": "lichun",
        "liu_nian_xing.year": 1983,
        "liu_nian_xing.year_boundary": "lichun"
      }
    },
    {
      "name": "xuankong_2024_before_lichun",
      "tool": "xuankong_chart",
      "input": {
        "zuo_shan": 2,
        "xiang_shan": 14,
        "standard_time": "2024-02-04T12:00:00+08:00"
      },
      "expect": {
        "yun.year": 2023,
        "yun.yun_number": 8,
        "yun.year_boundary": "lichun"
      }
    },
    {
      "name": "xuankong_2024_after_lichun",
      "tool": "xuankong_chart",
      "input": {
        "zuo_shan": 2,
        "xiang_shan": 14,
        "standard_time": "2024-02-04T18:00:00+08:00"
      },
      "expect": {
        "yun.year": 2024,
        "yun.yun_number": 9,
        "yun.year_boundary": "lichun"
      }
    },
    {
      "name": "bazi_liuri_last_boundary",
      "tool": "bazi_liuri",
      "chart_from": "bazi_chart_liuri.json",
      "input": {
        "longitude": 116.4,
        "standard_time": "2026-06-01T23:30:00+08:00"
      },
      "expect": {
        "date": "2026-06-01",
        "ri_gan": "丙",
        "ri_zhi": "午",
        "resolved.local_date": "2026-06-01",
        "resolved.last_date": "2026-06-01",
        "resolved.beijing_date": "2026-06-01"
      }
    },
    {
      "name": "ziwei_liuri_local_lunar",
      "tool": "ziwei_liuri",
      "chart_from": "ziwei_chart_liuri.json",
      "input": {
        "standard_time": "2026-06-01T23:30:00-05:00"
      },
      "expect": {
        "resolved.local_date": "2026-06-01",
        "resolved.beijing_date": "2026-06-02",
        "resolved.lunar.year": 2026,
        "resolved.lunar.month": 4,
        "resolved.lunar.day": 17,
        "resolved.lunar.leap": false
      }
    },
    {
      "name": "ziwei_liushi_last_shichen",
      "tool": "ziwei_liushi",
      "chart_from": "ziwei_chart_liushi.json",
      "input": {
        "longitude": -74.0,
        "standard_time": "2026-06-01T23:30:00-05:00"
      },
      "expect": {
        "zhi": "亥",
        "resolved.shichen": "亥",
        "resolved.local_date": "2026-06-01",
        "resolved.lunar.year": 2026,
        "resolved.lunar.month": 4,
        "resolved.lunar.day": 17
      }
    },
    {
      "name": "bazi_liunian_series_lichun",
      "tool": "bazi_liunian",
      "chart_from": "bazi_chart_liunian.json",
      "input": {
        "count": 3,
        "standard_time": "2024-01-20T12:00:00-05:00"
      },
      "expect": {
        "items.0.resolved.lichun_year": 2023,
        "items.1.resolved.lichun_year": 2024,
        "items.2.resolved.lichun_year": 2025
      }
    },
    {
      "name": "bazi_liuyue_series_jieqi",
      "tool": "bazi_liuyue",
      "chart_from": "bazi_chart_liuyue.json",
      "input": {
        "count": 3,
        "standard_time": "2024-01-14T23:00:00-05:00"
      },
      "expect": {
        "items.0.resolved.jieqi_start": "2024-01-05",
        "items.1.resolved.jieqi_start": "2024-02-04",
        "items.2.resolved.jieqi_start": "2024-03-04"
      }
    },
    {
      "name": "ziwei_chart_local_astronomical_default",
      "tool": "ziwei_chart",
      "input": {
        "longitude": -74.0,
        "gender": "male",
        "standard_time": "2024-02-09T23:30:00-05:00"
      },
      "expect": {
        "birth_year": 2024,
        "birth_lunar_month": 1,
        "lunar_day": 1
      }
    },
    {
      "name": "ziwei_liuri_local_astronomical_default",
      "tool": "ziwei_liuri",
      "chart_from": "ziwei_chart_liuri.json",
      "input": {
        "standard_time": "2024-02-09T23:30:00-05:00"
      },
      "expect": {
        "resolved.local_date": "2024-02-09",
        "resolved.beijing_date": "2024-02-10",
        "resolved.lunar.year": 2024,
        "resolved.lunar.month": 1,
        "resolved.lunar.day": 1
      }
    },
    {
      "name": "ziwei_liunian_local_astronomical_default",
      "tool": "ziwei_liunian",
      "chart_from": "ziwei_chart_liuri.json",
      "input": {
        "standard_time": "2024-02-09T23:30:00-05:00"
      },
      "expect": {
        "resolved.selector_date": "2024-02-09",
        "resolved.lunar_year": 2024,
        "resolved.lunar_year_start": "2024-02-09",
        "resolved.boundary_day": true
      }
    },
    {
      "name": "ziwei_liuyue_local_astronomical_default",
      "tool": "ziwei_liuyue",
      "chart_from": "ziwei_chart_liuri.json",
      "input": {
        "standard_time": "2024-02-09T23:30:00-05:00"
      },
      "expect": {
        "resolved.selector_date": "2024-02-09",
        "resolved.lunar.year": 2024,
        "resolved.lunar.month": 1,
        "resolved.lunar.day": 1,
        "resolved.lunar_month_start": "2024-02-09",
        "resolved.lunar_month_end": "2024-03-10",
        "resolved.boundary_day": true
      }
    },
    {
      "name": "ziwei_liushi_local_astronomical_default",
      "tool": "ziwei_liushi",
      "chart_from": "ziwei_chart_liuri.json",
      "input": {
        "longitude": -74.0,
        "standard_time": "2024-02-09T23:30:00-05:00"
      },
      "expect": {
        "resolved.local_date": "2024-02-09",
        "resolved.lunar.year": 2024,
        "resolved.lunar.month": 1,
        "resolved.lunar.day": 1,
        "resolved.shichen": "子"
      }
    },
    {
      "name": "huangli_local_date_default",
      "tool": "huangli_days",
      "input": {
        "count": 1,
        "event": "sign",
        "standard_time": "2026-06-01T13:00:00-05:00"
      },
      "expect": {
        "0.date": "2026-06-01"
      }
    },
    {
      "tool": "tianwen_resolve",
      "input": {
        "calendar": "lunar",
        "lunar": {
          "year": 2024,
          "month": 1,
          "day": 1,
          "leap": false
        },
        "time": "12:00",
        "timezone": "America/New_York",
        "longitude": -74.0
      },
      "name": "tianwen_resolve_lunar_local_astronomical",
      "expect": {
        "candidates.0.standard_time": "2024-02-09T12:00:00-05:00"
      }
    },
    {
      "name": "bazi_liunian_lichun_instant_before",
      "tool": "bazi_liunian",
      "chart_from": "bazi_chart_liunian.json",
      "input": {
        "standard_time": "2024-02-04T03:27:06-05:00"
      },
      "expect": {
        "resolved.selector_date": "2024-02-04",
        "resolved.lichun_year": 2023
      }
    },
    {
      "name": "bazi_liunian_lichun_instant_after",
      "tool": "bazi_liunian",
      "chart_from": "bazi_chart_liunian.json",
      "input": {
        "standard_time": "2024-02-04T03:27:07-05:00"
      },
      "expect": {
        "resolved.selector_date": "2024-02-04",
        "resolved.lichun_year": 2024
      }
    },
    {
      "name": "bazi_liuyue_jieqi_instant_before",
      "tool": "bazi_liuyue",
      "chart_from": "bazi_chart_liuyue.json",
      "input": {
        "standard_time": "2024-03-04T21:22:44-05:00"
      },
      "expect": {
        "resolved.jieqi_start": "2024-02-04"
      }
    },
    {
      "name": "bazi_liuyue_jieqi_instant_after",
      "tool": "bazi_liuyue",
      "chart_from": "bazi_chart_liuyue.json",
      "input": {
        "standard_time": "2024-03-04T21:22:45-05:00"
      },
      "expect": {
        "resolved.jieqi_start": "2024-03-04"
      }
    },
    {
      "name": "xuankong_liunian_local_date",
      "tool": "xuankong_liunian",
      "input": {
        "standard_time": "2024-02-03T21:27:07-11:00"
      },
      "expect": {
        "resolved.lichun_year": 2024,
        "resolved.lichun_start": "2024-02-03",
        "resolved.boundary_day": true
      }
    }
  ]
}

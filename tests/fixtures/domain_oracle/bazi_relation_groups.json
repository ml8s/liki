{
  "schema_version": "domain-oracle-bazi-relation-groups-v4",
  "basis": "天干五合、天干相冲、地支六合、三合、半合、三会、六冲、六害、三刑、六破与暗合通行口径；三合/三会组成立必须成员齐备，半合必须含旺支，自刑须同支成双。紧邻天干五合 / 相冲进 gan_he / gan_chong，隔位 / 远隔只进对应 candidate。",
  "sources": [
    "《三命通会》合会冲刑",
    "《子平真诠》地支关系",
    "《三命通会》天干五合",
    "《三命通会》天干相冲"
  ],
  "cases": [
    {
      "id": "gan-he-and-branch-he",
      "pillars": [
        "甲子",
        "己巳",
        "甲子",
        "乙丑"
      ],
      "expected": [
        {
          "field": "gan_he",
          "group": "甲己"
        },
        {
          "field": "zhi_liu_he",
          "group": "子丑"
        }
      ]
    },
    {
      "id": "complete-sanhe",
      "pillars": [
        "甲申",
        "甲子",
        "甲辰",
        "甲子"
      ],
      "expected": [
        {
          "field": "san_he",
          "group": "申子辰"
        }
      ]
    },
    {
      "id": "chou-xu-wei-xing",
      "pillars": [
        "乙丑",
        "甲戌",
        "甲未",
        "甲子"
      ],
      "expected": [
        {
          "field": "an_he",
          "group": "子戌"
        },
        {
          "field": "liu_chong",
          "group": "丑未"
        },
        {
          "field": "liu_hai",
          "group": "子未"
        },
        {
          "field": "liu_po",
          "group": "戌未"
        },
        {
          "field": "liu_xing",
          "group": "丑戌未"
        },
        {
          "field": "zhi_liu_he",
          "group": "子丑"
        }
      ]
    },
    {
      "id": "zi-self-xing-requires-pair",
      "pillars": [
        "甲子",
        "甲子",
        "甲午",
        "甲午"
      ],
      "expected": [
        {
          "field": "liu_chong",
          "group": "子午"
        },
        {
          "field": "liu_xing",
          "group": "午午"
        }
      ]
    },
    {
      "id": "non-adjacent-stem-he-is-candidate-not-tight-group",
      "pillars": [
        "甲子",
        "丙寅",
        "己巳",
        "庚午"
      ],
      "expected": [
        {
          "field": "gan_chong_candidate",
          "group": "甲庚"
        },
        {
          "field": "gan_he_candidate",
          "group": "甲己"
        },
        {
          "field": "liu_chong",
          "group": "子午"
        },
        {
          "field": "liu_hai",
          "group": "寅巳"
        },
        {
          "field": "san_he_partial",
          "group": "寅午"
        }
      ]
    },
    {
      "id": "adjacent-and-separated-gan-chong",
      "pillars": [
        "甲子",
        "庚午",
        "丙寅",
        "壬申"
      ],
      "expected": [
        {
          "field": "gan_chong",
          "group": "丙壬"
        },
        {
          "field": "gan_chong",
          "group": "甲庚"
        },
        {
          "field": "liu_chong",
          "group": "子午"
        },
        {
          "field": "liu_chong",
          "group": "寅申"
        },
        {
          "field": "san_he_partial",
          "group": "寅午"
        },
        {
          "field": "san_he_partial",
          "group": "申子"
        }
      ]
    }
  ]
}

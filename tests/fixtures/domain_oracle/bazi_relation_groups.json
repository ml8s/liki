{
  "schema_version": "domain-oracle-bazi-relation-groups-v1",
  "basis": "天干五合、地支六合、三合、三会、六冲、六害与三刑通行口径；组成立必须成员齐备，自刑须同支成双。；天干五合按引擎既有邻柱口径成立，隔柱不构成五合组。",
  "sources": [
    "《三命通会》合会冲刑",
    "《子平真诠》地支关系",
    "天干五合邻柱口径"
  ],
  "cases": [
    {
      "id": "gan-he-and-branch-he",
      "pillars": [
        "甲子",
        "己巳",
        "甲子",
        "乙丑"
      ],
      "expected": [
        {
          "field": "gan_he",
          "group": "甲己"
        },
        {
          "field": "zhi_liu_he",
          "group": "子丑"
        }
      ]
    },
    {
      "id": "complete-sanhe",
      "pillars": [
        "甲申",
        "甲子",
        "甲辰",
        "甲子"
      ],
      "expected": [
        {
          "field": "san_he",
          "group": "申子辰"
        }
      ]
    },
    {
      "id": "chou-xu-wei-xing",
      "pillars": [
        "乙丑",
        "甲戌",
        "甲未",
        "甲子"
      ],
      "expected": [
        {
          "field": "liu_chong",
          "group": "丑未"
        },
        {
          "field": "liu_hai",
          "group": "子未"
        },
        {
          "field": "liu_xing",
          "group": "丑戌未"
        },
        {
          "field": "zhi_liu_he",
          "group": "子丑"
        }
      ]
    },
    {
      "id": "zi-self-xing-requires-pair",
      "pillars": [
        "甲子",
        "甲子",
        "甲午",
        "甲午"
      ],
      "expected": [
        {
          "field": "liu_chong",
          "group": "子午"
        },
        {
          "field": "liu_xing",
          "group": "午午"
        }
      ]
    },
    {
      "id": "non-adjacent-stem-he-is-not-group",
      "pillars": [
        "甲子",
        "丙寅",
        "己巳",
        "庚午"
      ],
      "expected": [
        {
          "field": "liu_chong",
          "group": "子午"
        },
        {
          "field": "liu_hai",
          "group": "寅巳"
        }
      ]
    }
  ]
}

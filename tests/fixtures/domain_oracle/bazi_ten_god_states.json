{
  "schema_version": "domain-oracle-bazi-ten-god-states-v1",
  "basis": "十神显隐按四柱天干与藏干；通根按同五行藏干；得令按月令旺相；组合旺弱采用得令，或透干且通根即旺，失令且不透无根才弱。",
  "sources": [
    "《渊海子平》天干透显与地支藏干",
    "《子平真诠》根重身轻与得令为先",
    "五行旺相休囚死通行口径"
  ],

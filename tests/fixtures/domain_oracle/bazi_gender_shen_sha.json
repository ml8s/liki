{
  "schema_version": "domain-oracle-bazi-gender-shen-sha-v1",
  "basis": "勾绞煞以年支命前三辰、命后三辰相对取位；阳男阴女前三辰为勾、后三辰为绞，阴男阳女相反。元辰以年支对冲支为基点；阳男阴女取冲前一位，阴男阳女取冲后一位。",
  "sources": [
    "《三命通会·论勾绞》",
    "《三命通会·论元辰》"
  ],
  "cases": [
    {
      "id": "jia-zi-yang-male",
      "pillars": ["甲子", "乙卯", "辛酉", "乙未"],
      "gender": "male",
      "expected": {
        "勾神": ["yue"],
        "绞神": ["ri"],
        "元辰": ["shi"]
      },
      "why": "甲子阳男：命前三辰卯为勾，命后三辰酉为绞；子冲午，冲前一位未为元辰。"
    },
    {
      "id": "jia-zi-yang-female",
      "pillars": ["甲子", "乙卯", "辛酉", "乙巳"],
      "gender": "female",
      "expected": {
        "勾神": ["ri"],
        "绞神": ["yue"],
        "元辰": ["shi"]
      },
      "why": "甲子阳女：命前三辰卯为绞，命后三辰酉为勾；子冲午，冲后一位巳为元辰。"
    },
    {
      "id": "yi-chou-yin-male",
      "pillars": ["乙丑", "戊辰", "甲戌", "甲午"],
      "gender": "male",
      "expected": {
        "勾神": ["ri"],
        "绞神": ["yue"],
        "元辰": ["shi"]
      },
      "why": "乙丑阴男：命前三辰辰为绞，命后三辰戌为勾；丑冲未，冲后一位午为元辰。"
    },
    {
      "id": "yi-chou-yin-female",
      "pillars": ["乙丑", "戊辰", "甲戌", "甲申"],
      "gender": "female",
      "expected": {
        "勾神": ["yue"],
        "绞神": ["ri"],
        "元辰": ["shi"]
      },
      "why": "乙丑阴女：命前三辰辰为勾，命后三辰戌为绞；丑冲未，冲前一位申为元辰。"
    }
  ]
}

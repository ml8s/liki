{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liki.hk/contracts/mcp-tool-catalog-v1.json",
  "title": "Liki MCP tool catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtime_version", "servers"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "runtime_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
    },
    "servers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tools"],
        "properties": {
          "tools": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,127}$"
            }
          }
        }
      }
    }
  }
}

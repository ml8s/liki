{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liki.hk/contracts/agent-deployment-v1.json",
  "title": "AgentDeployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agent.liki/v1" },
    "kind": { "const": "AgentDeployment" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents"],
      "properties": {
        "mcpServers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "endpointEnv"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "endpointEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
              "tokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
            }
          }
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "description", "mode", "instruction", "tools"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "version": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["chat", "task", "single_turn"] },
              "model": { "type": "string", "minLength": 1 },
              "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
              "maxOutputTokens": { "type": "integer", "minimum": 1 },
              "skills": { "type": "object", "additionalProperties": false, "properties": { "root": { "type": "string", "minLength": 1, "pattern": "^/" }, "preload": { "type": "string", "enum": ["frontmatter", "complete"] } }, "required": ["root"] },
              "sub_agents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "instruction": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 }
                }
              },
              "output": {
                "type": "object",
                "additionalProperties": false,
                "dependentRequired": {
                  "schema": ["textPointer"],
                  "textPointer": ["schema"]
                },
                "properties": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 }
                    }
                  },
                  "textPointer": {
                    "type": "string",
                    "pattern": "^/(?:~[01]|[^~])+(?:/(?:~[01]|[^~])+)*$"
                  }
                }
              },
              "tools": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allow"],
                "properties": {
                  "allow": {
                    "type": "object",
                    "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
                    "additionalProperties": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

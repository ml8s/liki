{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liki:qimen-session-v1",
  "title": "奇门追问会话契约",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "session_id",
    "question",
    "input",
    "method",
    "snapshot_digest",
    "snapshot",
    "first_verdict",
    "integrity",
    "followups",
    "policy"
  ],
  "properties": {
    "$schema": {"const": "liki:qimen-session-v1"},
    "schema_version": {"const": "qimen-session-v1"},
    "session_id": {"type": "string", "minLength": 8},
    "question": {"type": "string", "minLength": 2},
    "input": {
      "type": "object",
      "required": ["local_time", "solar_time"],
      "properties": {
        "city": {"type": ["string", "null"]},
        "longitude": {"type": "number"},
        "local_time": {"type": "string"},
        "solar_time": {"type": "string"}
      }
    },
    "method": {
      "type": "object",
      "required": ["scope", "school"],
      "properties": {
        "scope": {"type": "string"},
        "school": {"type": "string"}
      }
    },
    "snapshot_digest": {"type": "string"},
    "snapshot": {"type": "object"},
    "first_verdict": {
      "type": "object",
      "required": ["headline", "verdict", "confidence"],
      "properties": {
        "headline": {"type": "string"},
        "verdict": {"type": "string"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "report": {"type": ["object", "null"]}
      }
    },
    "integrity": {
      "type": "object",
      "required": ["input", "method", "snapshot", "first_verdict", "report"],
      "properties": {
        "input": {"type": "string"},
        "method": {"type": "string"},
        "snapshot": {"type": "string"},
        "first_verdict": {"type": "string"},
        "report": {"type": ["string", "null"]}
      }
    },
    "followups": {"type": "array"},
    "policy": {
      "type": "object",
      "required": [
        "immutable_input",
        "immutable_method",
        "immutable_first_verdict",
        "no_recast_without_new_event"
      ],
      "properties": {
        "immutable_input": {"const": true},
        "immutable_method": {"const": true},
        "immutable_first_verdict": {"const": true},
        "no_recast_without_new_event": {"const": true}
      }
    }
  }
}

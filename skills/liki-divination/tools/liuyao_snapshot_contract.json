{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liki:liuyao-snapshot-v4",
  "title": "六爻 immutable snapshot 契约",
  "type": "object",
  "required": [
    "schema_version",
    "question",
    "casting",
    "board",
    "focus",
    "evidence",
    "facts",
    "timing_candidates",
    "policy",
    "method",
    "snapshot_digest",
    "matter",
    "topic",
    "topic_guidance",
    "timing_plan",
    "condition_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "liuyao-snapshot-v4"
    },
    "question": {
      "type": "object",
      "required": [
        "text",
        "matter",
        "explicit_yong_shen",
        "perspective",
        "solar_time"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 2
        },
        "matter": {
          "type": [
            "string",
            "null"
          ]
        },
        "explicit_yong_shen": {
          "type": [
            "string",
            "null"
          ]
        },
        "perspective": {
          "type": [
            "string",
            "null"
          ]
        },
        "solar_time": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "casting": {
      "type": "object",
      "required": [
        "mode",
        "order",
        "casting_id",
        "yaos",
        "dong_yao"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "coins",
            "yaos"
          ]
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "coins": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "enum": [
                    "正",
                    "反"
                  ]
                }
              },
              "value": {
                "type": "integer",
                "minimum": 6,
                "maximum": 9
              },
              "label": {
                "type": "string",
                "enum": [
                  "老阴",
                  "少阳",
                  "少阴",
                  "老阳"
                ]
              },
              "changing": {
                "type": "boolean"
              }
            },
            "required": [
              "position",
              "coins",
              "value",
              "label",
              "changing"
            ]
          }
        },
          "yaos": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 6,
            "maximum": 9
          }
        },
        "dong_yao": {
          "type": "array"
        },
        "casting_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "canonical deterministic casting identity"
        },
        "order": {
          "type": "string",
          "const": "bottom_up"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "coins"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "rounds"
            ],
            "properties": {
              "rounds": {
                "minItems": 6,
                "maxItems": 6
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "yaos"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "rounds": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "board": {
      "type": "object",
      "required": [
        "name",
        "ben_gua",
        "palace",
        "lines"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ben_gua": {
          "type": "string"
        },
        "bian_gua": {
          "type": [
            "string",
            "null"
          ]
        },
        "palace": {
          "type": "string"
        },
        "palace_wuxing": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6
        }
      },
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "required": [
        "yong_shen"
      ],
      "properties": {
        "yong_shen": {
          "type": "object"
        },
        "yong_line": {
          "type": [
            "object",
            "null"
          ]
        },
        "world": {
          "type": [
            "object",
            "null"
          ]
        },
        "other": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "reference",
        "conflicts",
        "ignored_scope"
      ],
      "properties": {
        "primary": {
          "type": "array"
        },
        "secondary": {
          "type": "array"
        },
        "reference": {
          "type": "array"
        },
        "conflicts": {
          "type": "array"
        },
        "ignored_scope": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "object",
      "required": [
        "hidden_lines",
        "branch_relation_facts",
        "day_clash_facts",
        "moving_transformations",
        "san_he_candidates",
        "force_chain",
        "yong_shen_candidates"
      ]
    },
    "timing_candidates": {
      "type": "array"
    },
    "policy": {
      "type": "object",
      "required": [
        "may_output",
        "must_cover_conflicts",
        "forbidden",
        "immutable",
        "no_recast_without_new_event"
      ],
      "properties": {
        "may_output": {
          "type": "array"
        },
        "must_cover_conflicts": {
          "type": "boolean"
        },
        "forbidden": {
          "type": "array"
        },
        "immutable": {
          "const": true
        },
        "no_recast_without_new_event": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "method": {
      "const": "liuyao"
    },
    "snapshot_digest": {
      "type": "string",
      "minLength": 16
    },
    "matter": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "topic_guidance": {
      "type": [
        "object",
        "null"
      ]
    },
    "timing_plan": {
      "type": "object"
    },
    "condition_rules": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

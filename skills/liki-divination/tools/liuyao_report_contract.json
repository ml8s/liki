{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liki:liuyao-report-v1",
  "title": "六爻结构化报告契约",
  "type": "object",
  "required": [
    "schema_version",
    "headline",
    "verdict",
    "confidence",
    "primary_evidence_refs",
    "secondary_evidence_refs",
    "conflicts",
    "timing_refs",
    "action",
    "boundary",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "const": "liuyao-report-v1"
    },
    "headline": {
      "type": "string",
      "minLength": 4,
      "maxLength": 160
    },
    "verdict": {
      "type": "string",
      "minLength": 8
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "primary_evidence_refs": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "secondary_evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "conflicts": {
      "type": "array",
      "items": {"type": "object"}
    },
    "timing_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "action": {
      "type": "string",
      "minLength": 4
    },
    "boundary": {
      "type": "string",
      "minLength": 8
    },
    "disclaimer": {
      "type": "string",
      "minLength": 8
    }
  },
  "additionalProperties": false
}

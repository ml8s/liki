{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liki:qimen-report-v1",
  "title": "奇门结构化报告契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "headline",
    "verdict",
    "confidence",
    "question_ref",
    "method_ref",
    "evidence_refs",
    "assertion_refs",
    "timing_refs",
    "conflicts",
    "action",
    "boundary",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {"const": "qimen-report-v1"},
    "headline": {"type": "string", "minLength": 4, "maxLength": 160},
    "verdict": {"type": "string", "minLength": 8},
    "confidence": {"enum": ["low", "medium", "high"]},
    "question_ref": {"type": "string"},
    "method_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "school", "matter"],
      "properties": {
        "scope": {"type": ["string", "null"]},
        "school": {"type": ["string", "null"]},
        "matter": {"type": ["string", "null"]}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^snapshot:"}
    },
    "assertion_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^assertion:"}
    },
    "timing_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^timing:"}
    },
    "conflicts": {
      "type": "array",
      "items": {"type": "object"}
    },
    "action": {"type": "string", "minLength": 4},
    "boundary": {"type": "string", "minLength": 8},
    "disclaimer": {"type": "string", "minLength": 8}
  }
}

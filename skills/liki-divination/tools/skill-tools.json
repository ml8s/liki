{
  "$schema": "https://json.schemastore.org/tools.json",
  "info": {
    "title": "liki-divination 奇门 / 六爻 / 黄历工具",
    "description": "问卦分域 snapshot 与 ask 工具。唯一执行方式：python3 tools/agent_cli.py。",
    "version": "2026.09.09.0"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "liuyao_snapshot",
        "description": "创建六爻 immutable snapshot：auto/coins/yaos 起卦、排盘、用神因子、专题、应期候选一次完成。后续追问必须复用该 snapshot。",
        "parameters": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 2,
              "description": "本次要判断的一个具体目标"
            },
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "coins",
                "yaos"
              ],
              "default": "auto",
              "description": "起卦方式"
            },
            "rounds": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "description": "coins 模式必填；六组三枚正/反，顺序为初爻到上爻",
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "enum": [
                    "正",
                    "反"
                  ]
                }
              }
            },
            "yaos": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "description": "yaos 模式必填；六个爻值 6-9，初爻到上爻",
              "items": {
                "type": "integer",
                "minimum": 6,
                "maximum": 9
              }
            },
            "matter": {
              "type": "string",
              "enum": [
                "general",
                "self",
                "other",
                "career",
                "wealth",
                "relationship",
                "study",
                "home",
                "travel",
                "family",
                "competition",
                "children",
                "lost_item",
                "legal"
              ],
              "description": "普通问事类别；与 yong_shen 互斥"
            },
            "yong_shen": {
              "type": "string",
              "enum": [
                "父母",
                "兄弟",
                "官鬼",
                "妻财",
                "子孙",
                "世爻",
                "应爻"
              ],
              "description": "高级显式用神；与 matter 互斥"
            },
            "perspective": {
              "type": "string",
              "enum": [
                "male",
                "female",
                "unspecified"
              ],
              "description": "仅 relationship 使用"
            },
            "topic": {
              "type": "string",
              "enum": [
                "wealth",
                "career",
                "marriage",
                "study",
                "lost_item",
                "travel",
                "lawsuit",
                "health_context"
              ],
              "description": "可选专题；省略时按 matter 推导"
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "matter"
              ]
            },
            {
              "required": [
                "yong_shen"
              ]
            }
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "liuyao_ask",
        "description": "基于同一个 immutable liuyao snapshot 追问；校验 digest 后返回结构化条件性 answer，不重排。",
        "parameters": {
          "type": "object",
          "properties": {
            "snapshot": {
              "type": "object",
              "description": "liuyao_snapshot 返回的完整 snapshot",
              "required": [
                "method",
                "schema_version",
                "snapshot_digest"
              ],
              "properties": {
                "method": {
                  "const": "liuyao"
                },
                "schema_version": {
                  "const": "liuyao-snapshot-v3"
                },
                "snapshot_digest": {
                  "type": "string"
                }
              }
            },
            "message": {
              "type": "string",
              "minLength": 2,
              "description": "本次追问内容"
            }
          },
          "required": [
            "snapshot",
            "message"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "qimen_snapshot",
        "description": "创建奇门 immutable snapshot：自动补时间、换算真太阳时、排盘、因子投影和可选专占查询一次完成。",
        "parameters": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 2,
              "description": "本次要判断的一个具体目标"
            },
            "city": {
              "type": "string",
              "description": "起局地点；与 longitude 二选一"
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "description": "起局经度；与 city 二选一"
            },
            "time": {
              "type": "string",
              "description": "起局钟表时间 RFC3339；缺省使用服务端当前时间"
            },
            "matter": {
              "type": "string",
              "enum": [
                "career",
                "health",
                "hiding",
                "legal",
                "missing_person",
                "relationship",
                "study",
                "travel",
                "wealth"
              ],
              "description": "普通事象；与 yong_shen 互斥"
            },
            "yong_shen": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              },
              "description": "高级显式用神；与 matter 互斥"
            },
            "rule": {
              "type": "string",
              "enum": [
                "lost_property",
                "thief_capture",
                "missing_person",
                "capture_escape",
                "thief_profile"
              ],
              "description": "可选专占规则"
            },
            "scope": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "quarter",
                "month",
                "year"
              ],
              "description": "奇门范围；缺省 hour"
            },
            "school": {
              "type": "string",
              "enum": [
                "zhuanpan",
                "luoshu_feipan",
                "mingfa_feipan",
                "jinhan_yujing"
              ],
              "description": "奇门流派；缺省 zhuanpan"
            },
            "dingju_method": {
              "type": "string",
              "enum": [
                "chaibu",
                "zhirun",
                "maoshan"
              ],
              "description": "定局方法；仅支持范围可用"
            },
            "quarter_rule": {
              "type": "string",
              "enum": [
                "ten_minute_sanyuan",
                "twelve_minute_ten_division"
              ],
              "description": "刻家规则；仅 scope=quarter 使用"
            },
            "base_dingju_method": {
              "type": "string",
              "enum": [
                "chaibu",
                "zhirun",
                "maoshan"
              ],
              "description": "十二分钟十分局基准定局法"
            },
            "dun_source": {
              "type": "string",
              "enum": [
                "hour_branch",
                "solar_term"
              ],
              "description": "十二分钟十分局遁甲来源"
            },
            "hour_boundary": {
              "type": "string",
              "enum": [
                "late_zi",
                "zi_zheng"
              ],
              "description": "子时边界口径"
            },
            "birth_date": {
              "type": "string",
              "description": "出生日期或时刻，用于年命干落宫"
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "city"
              ]
            },
            {
              "required": [
                "longitude"
              ]
            }
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "qimen_ask",
        "description": "基于同一个 immutable qimen snapshot 追问；校验 digest 后返回结构化条件性 answer，不重排。",
        "parameters": {
          "type": "object",
          "properties": {
            "snapshot": {
              "type": "object",
              "description": "qimen_snapshot 返回的完整 snapshot",
              "required": [
                "method",
                "schema_version",
                "snapshot_digest"
              ],
              "properties": {
                "method": {
                  "const": "qimen"
                },
                "schema_version": {
                  "const": "qimen-snapshot-v3"
                },
                "snapshot_digest": {
                  "type": "string"
                }
              }
            },
            "message": {
              "type": "string",
              "minLength": 2,
              "description": "本次追问内容"
            }
          },
          "required": [
            "snapshot",
            "message"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "huangli_days",
        "description": "黄历择日一次编排：统一安全分流、解析日期范围，并按建除事项返回推荐 / 排除候选。",
        "parameters": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "description": "用户原问题；用于安全分流和复核"
            },
            "event": {
              "type": "string",
              "enum": [
                "wedding",
                "engage",
                "opening",
                "sign",
                "move",
                "travel",
                "build",
                "exam",
                "medical",
                "funeral"
              ],
              "description": "择日事项；也可传中文别名"
            },
            "start_date": {
              "type": "string",
              "description": "起始日期 YYYY-MM-DD；缺省为服务端当前日期次日"
            },
            "end_date": {
              "type": "string",
              "description": "结束日期 YYYY-MM-DD，包含当日；与 days 二选一"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "连续查询天数；默认30天"
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}

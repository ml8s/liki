{
  "$schema": "https://json.schemastore.org/tools.json",
  "info": {
    "title": "liki-divination 奇门 / 六爻 / 黄历工具",
    "description": "问卦分域 snapshot 与 ask 工具。唯一执行方式：python3 tools/agent_cli.py。",
    "version": "2026.09.11.0"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "liuyao_snapshot",
        "description": "创建六爻 immutable snapshot：auto/coins/yaos 起卦、排盘、用神因子、专题、应期候选一次完成。后续追问必须复用该 snapshot。",
        "parameters": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "description": "本次要判断的一个具体目标"
            },
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "coins",
                "yaos"
              ],
              "default": "auto",
              "description": "起卦方式"
            },
            "rounds": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "description": "coins 模式必填；六组三枚正/反，顺序为初爻到上爻",
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "enum": [
                    "正",
                    "反"
                  ]
                }
              }
            },
            "yaos": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "description": "yaos 模式必填；六个爻值 6-9，初爻到上爻",
              "items": {
                "type": "integer",
                "minimum": 6,
                "maximum": 9
              }
            },
            "matter": {
              "type": "string",
              "enum": [
                "general",
                "self",
                "other",
                "career",
                "wealth",
                "relationship",
                "study",
                "home",
                "travel",
                "family",
                "competition",
                "children",
                "lost_item",
                "legal"
              ],
              "description": "普通问事类别；必须与 yong_shen 二选一"
            },
            "yong_shen": {
              "type": "string",
              "enum": [
                "父母",
                "兄弟",
                "官鬼",
                "妻财",
                "子孙",
                "世爻",
                "应爻"
              ],
              "description": "高级显式用神；必须与 matter 二选一"
            },
            "perspective": {
              "type": "string",
              "enum": [
                "male",
                "female"
              ],
              "description": "relationship 必填；男问取妻财，女问取官鬼"
            },
            "topic": {
              "type": "string",
              "enum": [
                "wealth",
                "career",
                "marriage",
                "study",
                "lost_item",
                "travel",
                "lawsuit",
                "health_context"
              ],
              "description": "可选专题；省略时按 matter 推导"
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "matter"
                  ],
                  "not": {
                    "required": [
                      "yong_shen"
                    ]
                  }
                },
                {
                  "required": [
                    "yong_shen"
                  ],
                  "not": {
                    "required": [
                      "matter"
                    ]
                  }
                }
              ]
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "coins"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "rounds"
                ],
                "not": {
                  "required": [
                    "yaos"
                  ]
                }
              }
            },
            {
              "if": {
                "anyOf": [
                  {
                    "required": [
                      "rounds"
                    ]
                  },
                  {
                    "required": [
                      "yaos"
                    ]
                  }
                ]
              },
              "then": {
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "coins",
                      "yaos"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "yaos"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "required": [
                  "yaos"
                ],
                "not": {
                  "required": [
                    "rounds"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "auto"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "rounds"
                      ]
                    },
                    {
                      "required": [
                        "yaos"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "perspective"
                ]
              },
              "then": {
                "properties": {
                  "matter": {
                    "const": "relationship"
                  }
                },
                "required": [
                  "matter"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "matter": {
                    "const": "relationship"
                  }
                },
                "required": [
                  "matter"
                ]
              },
              "then": {
                "required": [
                  "perspective"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "liuyao_ask",
        "description": "基于同一个 immutable liuyao snapshot 追问；校验 digest 后返回结构化条件性 answer，不重排。",
        "parameters": {
          "type": "object",
          "properties": {
            "snapshot": {
              "type": "object",
              "description": "liuyao_snapshot 返回的完整 snapshot",
              "required": [
                "method",
                "schema_version",
                "snapshot_digest"
              ],
              "properties": {
                "method": {
                  "const": "liuyao"
                },
                "schema_version": {
                  "const": "liuyao-snapshot-v4"
                },
                "snapshot_digest": {
                  "type": "string"
                }
              }
            },
            "message": {
              "type": "string",
              "minLength": 2,
              "description": "本次追问内容"
            }
          },
          "required": [
            "snapshot",
            "message"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "qimen_snapshot",
        "description": "创建奇门 immutable snapshot：自动补时间、换算真太阳时、排盘、因子投影和可选专占查询一次完成。",
        "parameters": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "description": "本次要判断的一个具体目标"
            },
            "city": {
              "type": "string",
              "description": "起局地点；与 longitude 二选一",
              "minLength": 1
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "description": "起局经度；与 city 二选一"
            },
            "time": {
              "type": "string",
              "description": "起局钟表时间 RFC3339；缺省使用服务端当前时间",
              "format": "date-time"
            },
            "matter": {
              "type": "string",
              "enum": [
                "career",
                "health",
                "hiding",
                "legal",
                "missing_person",
                "relationship",
                "study",
                "travel",
                "wealth"
              ],
              "description": "普通事象；必须与 yong_shen 二选一"
            },
            "yong_shen": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              },
              "description": "高级显式用神；必须与 matter 二选一"
            },
            "rule": {
              "type": "string",
              "enum": [
                "lost_property",
                "thief_capture",
                "missing_person",
                "capture_escape",
                "thief_profile"
              ],
              "description": "可选专占规则；由因子契约校验适用盘型"
            },
            "scope": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "quarter",
                "month",
                "year"
              ],
              "description": "奇门范围；缺省 hour"
            },
            "school": {
              "type": "string",
              "enum": [
                "zhuanpan",
                "luoshu_feipan",
                "mingfa_feipan",
                "jinhan_yujing"
              ],
              "description": "奇门流派；缺省 zhuanpan"
            },
            "dingju_method": {
              "type": "string",
              "enum": [
                "chaibu",
                "zhirun",
                "maoshan"
              ],
              "description": "定局方法；仅支持范围可用"
            },
            "quarter_rule": {
              "type": "string",
              "enum": [
                "ten_minute_sanyuan",
                "twelve_minute_ten_division"
              ],
              "description": "刻家规则；仅 scope=quarter 使用"
            },
            "base_dingju_method": {
              "type": "string",
              "enum": [
                "chaibu",
                "zhirun",
                "maoshan"
              ],
              "description": "十二分钟十分局基准定局法"
            },
            "dun_source": {
              "type": "string",
              "enum": [
                "hour_branch",
                "solar_term"
              ],
              "description": "十二分钟十分局遁甲来源"
            },
            "hour_boundary": {
              "type": "string",
              "enum": [
                "late_zi",
                "zi_zheng"
              ],
              "description": "子时边界口径"
            },
            "birth_date": {
              "type": "string",
              "description": "出生日期或时刻，用于年命干落宫"
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "oneOf": [
                {
                  "required": [
                    "city"
                  ],
                  "not": {
                    "required": [
                      "longitude"
                    ]
                  }
                },
                {
                  "required": [
                    "longitude"
                  ],
                  "not": {
                    "required": [
                      "city"
                    ]
                  }
                }
              ]
            },
            {
              "not": {
                "allOf": [
                  {
                    "required": [
                      "matter"
                    ]
                  },
                  {
                    "required": [
                      "yong_shen"
                    ]
                  }
                ]
              }
            },
            {
              "if": {
                "not": {
                  "required": [
                    "rule"
                  ]
                },
                "properties": {
                  "school": {
                    "not": {
                      "const": "jinhan_yujing"
                    }
                  },
                  "scope": {
                    "not": {
                      "const": "quarter"
                    }
                  }
                }
              },
              "then": {
                "oneOf": [
                  {
                    "required": [
                      "matter"
                    ],
                    "not": {
                      "required": [
                        "yong_shen"
                      ]
                    }
                  },
                  {
                    "required": [
                      "yong_shen"
                    ],
                    "not": {
                      "required": [
                        "matter"
                      ]
                    }
                  }
                ]
              }
            },
            {
              "if": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "matter"
                      ]
                    },
                    {
                      "required": [
                        "yong_shen"
                      ]
                    }
                  ]
                },
                "properties": {
                  "school": {
                    "not": {
                      "const": "jinhan_yujing"
                    }
                  },
                  "scope": {
                    "not": {
                      "const": "quarter"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "rule"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "school": {
                    "const": "jinhan_yujing"
                  }
                },
                "required": [
                  "school"
                ]
              },
              "then": {
                "properties": {
                  "scope": {
                    "const": "day"
                  },
                  "matter": {
                    "not": {}
                  },
                  "yong_shen": {
                    "not": {}
                  },
                  "rule": {
                    "not": {}
                  },
                  "birth_date": {
                    "not": {}
                  },
                  "dingju_method": {
                    "not": {}
                  },
                  "quarter_rule": {
                    "not": {}
                  },
                  "base_dingju_method": {
                    "not": {}
                  },
                  "dun_source": {
                    "not": {}
                  },
                  "hour_boundary": {
                    "not": {}
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "school": {
                    "const": "mingfa_feipan"
                  }
                },
                "required": [
                  "school"
                ]
              },
              "then": {
                "properties": {
                  "scope": {
                    "const": "hour"
                  },
                  "dingju_method": {
                    "const": "chaibu"
                  },
                  "quarter_rule": {
                    "not": {}
                  },
                  "base_dingju_method": {
                    "not": {}
                  },
                  "dun_source": {
                    "not": {}
                  },
                  "hour_boundary": {
                    "not": {}
                  }
                },
                "required": [
                  "scope",
                  "dingju_method"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "scope": {
                    "const": "quarter"
                  }
                },
                "required": [
                  "scope"
                ]
              },
              "then": {
                "properties": {
                  "school": {
                    "const": "zhuanpan"
                  },
                  "quarter_rule": {},
                  "dingju_method": {
                    "not": {}
                  }
                },
                "required": [
                  "quarter_rule"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "quarter_rule": {
                    "const": "ten_minute_sanyuan"
                  }
                },
                "required": [
                  "quarter_rule"
                ]
              },
              "then": {
                "base_dingju_method": {
                  "not": {}
                },
                "dun_source": {
                  "not": {}
                },
                "hour_boundary": {
                  "not": {}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "quarter_rule": {
                    "const": "twelve_minute_ten_division"
                  }
                },
                "required": [
                  "quarter_rule"
                ]
              },
              "then": {
                "required": [
                  "base_dingju_method",
                  "dun_source",
                  "hour_boundary"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "scope": {
                    "enum": [
                      "month",
                      "year"
                    ]
                  }
                },
                "required": [
                  "scope"
                ]
              },
              "then": {
                "dingju_method": {
                  "not": {}
                },
                "quarter_rule": {
                  "not": {}
                },
                "base_dingju_method": {
                  "not": {}
                },
                "dun_source": {
                  "not": {}
                },
                "hour_boundary": {
                  "not": {}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "dingju_method": {
                    "const": "maoshan"
                  }
                },
                "required": [
                  "dingju_method"
                ]
              },
              "then": {
                "properties": {
                  "scope": {
                    "const": "hour"
                  },
                  "school": {
                    "const": "zhuanpan"
                  }
                },
                "required": [
                  "scope",
                  "school"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "rule": {
                    "enum": [
                      "lost_property",
                      "thief_capture",
                      "capture_escape",
                      "thief_profile"
                    ]
                  }
                },
                "required": [
                  "rule"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "matter"
                      ]
                    },
                    {
                      "required": [
                        "yong_shen"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "rule": {
                    "const": "missing_person"
                  }
                },
                "required": [
                  "rule"
                ]
              },
              "then": {
                "properties": {
                  "matter": {
                    "const": "missing_person"
                  }
                },
                "required": [
                  "matter"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "qimen_ask",
        "description": "基于同一个 immutable qimen snapshot 追问；校验 digest 后返回结构化条件性 answer，不重排。",
        "parameters": {
          "type": "object",
          "properties": {
            "snapshot": {
              "type": "object",
              "description": "qimen_snapshot 返回的完整 snapshot",
              "required": [
                "method",
                "schema_version",
                "snapshot_digest"
              ],
              "properties": {
                "method": {
                  "const": "qimen"
                },
                "schema_version": {
                  "const": "qimen-snapshot-v3"
                },
                "snapshot_digest": {
                  "type": "string"
                }
              }
            },
            "message": {
              "type": "string",
              "minLength": 2,
              "description": "本次追问内容"
            }
          },
          "required": [
            "snapshot",
            "message"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "huangli_days",
        "description": "黄历择日一次编排：统一安全分流、解析日期范围，并按建除事项返回推荐 / 排除候选。",
        "parameters": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "description": "用户原问题；用于安全分流和复核"
            },
            "event": {
              "type": "string",
              "enum": [
                "wedding",
                "engage",
                "opening",
                "sign",
                "move",
                "travel",
                "build",
                "exam",
                "medical",
                "funeral"
              ],
              "description": "择日事项；使用规范英文事件名"
            },
            "start_date": {
              "type": "string",
              "description": "起始日期 YYYY-MM-DD；缺省为服务端当前日期次日",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end_date": {
              "type": "string",
              "description": "结束日期 YYYY-MM-DD，包含当日；与 days 二选一",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "连续查询天数；默认30天"
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "end_date"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "days"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "days"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "end_date"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}

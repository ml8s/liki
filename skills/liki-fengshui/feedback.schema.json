{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liki.hk/schemas/feedback-v1.json",
  "title": "Liki skill feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta", "agent", "llm", "problem"],
  "properties": {
    "schema_version": {
      "const": "feedback-v1"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "skill", "skill_version", "engine_version"],
      "properties": {
        "source": {
          "enum": ["skill-agent", "user"]
        },
        "skill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "skill_version": {
          "$ref": "#/$defs/version"
        },
        "engine_version": {
          "$ref": "#/$defs/version"
        },
        "session_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "$ref": "#/$defs/shortText"
        },
        "version": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "$ref": "#/$defs/shortText"
        },
        "model": {
          "$ref": "#/$defs/shortText"
        },
        "model_version": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity", "summary"],
      "properties": {
        "type": {
          "enum": ["error", "gap", "conflict", "friction", "clarity"]
        },
        "severity": {
          "enum": ["blocker", "high", "medium", "low"]
        },
        "tool": {
          "$ref": "#/$defs/shortText"
        },
        "summary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "expected": {
          "type": "string",
          "maxLength": 500
        },
        "observed": {
          "type": "string",
          "maxLength": 500
        },
        "dedup_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}

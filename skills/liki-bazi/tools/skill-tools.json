{
  "$schema": "https://json.schemastore.org/tools.json",
  "info": {
    "title": "liki Skill Tools — 命理工具",
    "description": "liki skill 的 6 个命理工具。唯一执行方式：python3 tools/agent_cli.py。",
    "version": "2026.08.28.1"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "city_coords",
        "description": "城市名→经纬度（交互式查询）。找不到时返回 error——问用户附近较大城市后重试。",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "城市名称"
            }
          },
          "required": [
            "city"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "full_paipan",
        "description": "排盘（本命）：八字+紫微一次排全，返回本命盘（pan）。pan 可直接传给 query、yearly_range 或 bond。流程：city_coords → full_paipan → query / yearly_range。",
        "parameters": {
          "type": "object",
          "properties": {
            "gender": {
              "type": "string",
              "enum": [
                "male",
                "female"
              ],
              "description": "性别"
            },
            "longitude": {
              "type": "number",
              "description": "出生地经度。correct=true 时必填（真太阳时校正需经度），correct=false 时可省略。通过 city_coords 获取。"
            },
            "correct": {
              "type": "boolean",
              "description": "true=按真太阳时校正（用户给具体时刻，需提供 longitude）；false=按给定时辰直接排（无需 longitude）",
              "default": true
            },
            "gregorian": {
              "type": "string",
              "format": "date-time",
              "description": "出生公历时间（Gregorian calendar，RFC3339 格式）。农历时间请自行转换为公历后传入。"
            }
          },
          "required": [
            "gregorian",
            "gender"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "query",
        "description": "断语查询（本命域）。仅支持本命域，流年走 yearly_range。",
        "parameters": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "description": "本命域：career/wealth/health/study/marriage/personality/family/geju/dayun/yingqi"
            },
            "pan": {
              "type": "object",
              "description": "full_paipan 返回的本命盘（可直接传或通过 $file 引用）"
            }
          },
          "required": [
            "rule",
            "pan"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "yearly_range",
        "description": "批量流年分析：一次调用替代逐年排盘+查断语。返回每年各域断语（精简格式）+ current_year。",
        "parameters": {
          "type": "object",
          "properties": {
            "pan": {
              "type": "object",
              "description": "full_paipan 返回的本命盘（可直接传或通过 $file 引用）"
            },
            "start": {
              "type": "integer",
              "description": "起始年份"
            },
            "end": {
              "type": "integer",
              "description": "结束年份（含）"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "流年域列表，默认 [yearly_career, yingqi]"
            },
            "detail": {
              "type": "boolean",
              "description": "true=全量断语；false=精简（默认）"
            }
          },
          "required": [
            "pan",
            "start",
            "end"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calibrate",
        "description": "定盘校验：多个候选生日 + 人生大事 → 每候选每事件的原始断语。不做命中判断——信号解读由 LLM 完成。",
        "parameters": {
          "type": "object",
          "properties": {
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "gender": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female"
                    ],
                    "description": "性别"
                  },
                  "longitude": {
                    "type": "number",
                    "description": "出生地经度（必填，通过 city_coords 获取）"
                  },
                  "correct": {
                    "type": "boolean",
                    "default": true,
                    "description": "是否真太阳时校正"
                  },
                  "label": {
                    "type": "string",
                    "description": "候选标签（如 25号/26号，必须唯一）"
                  },
                  "gregorian": {
                    "type": "string",
                    "description": "候选出生公历时间（Gregorian calendar，RFC3339）"
                  }
                },
                "required": [
                  "gregorian",
                  "gender",
                  "longitude",
                  "label"
                ]
              },
              "description": "候选出生信息列表（2-3 个，label 必须唯一）"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "year": {
                    "type": "integer",
                    "description": "事件发生年份"
                  },
                  "rule": {
                    "type": "string",
                    "description": "流年域（必须以 yearly_ 开头，如 yearly_marriage/yearly_career）"
                  },
                  "label": {
                    "type": "string",
                    "description": "事件描述（如 感情重大问题/换工作）"
                  }
                },
                "required": [
                  "year",
                  "rule",
                  "label"
                ]
              },
              "description": "人生大事列表（3-5 件含年份）"
            },
            "detail": {
              "type": "boolean",
              "description": "true=全量断语（含依据/经典原文）；false=精简（仅事件+结论）",
              "default": false
            }
          },
          "required": [
            "candidates",
            "events"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "bond",
        "description": "合盘：两张本命盘 → 八字合盘 + 紫微合盘，一次调用返回双盘结果。",
        "parameters": {
          "type": "object",
          "properties": {
            "pan_a": {
              "type": "object",
              "description": "甲方本命盘（full_paipan 返回，可直接传或通过 $file 引用）"
            },
            "pan_b": {
              "type": "object",
              "description": "乙方本命盘（full_paipan 返回，可直接传或通过 $file 引用）"
            }
          },
          "required": [
            "pan_a",
            "pan_b"
          ]
        }
      }
    }
  ]
}
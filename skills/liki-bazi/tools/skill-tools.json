{
  "$schema": "https://json.schemastore.org/tools.json",
  "info": {
    "title": "liki Skill Tools — 命理工具",
    "description": "liki skill 的 6 个命理工具。唯一执行方式：python3 tools/agent_cli.py。",
    "version": "2026.09.05.1"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "city_coords",
        "description": "城市名→经纬度（交互式查询）。找不到时返回 error——问用户附近较大城市后重试。",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "城市名称"
            }
          },
          "required": [
            "city"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "full_paipan",
        "description": "排盘（本命）：八字+紫微一次排全，返回本命盘（pan）。pan 可直接传给 query、yearly_range 或 bond。流程：city_coords → full_paipan → query / yearly_range。",
        "parameters": {
          "type": "object",
          "properties": {
            "gender": {
              "type": "string",
              "enum": [
                "male",
                "female"
              ],
              "description": "性别"
            },
            "longitude": {
              "type": "number",
              "description": "出生地经度。correct=true 时必填（真太阳时校正需经度），correct=false 时可省略。通过 city_coords 获取。"
            },
            "correct": {
              "type": "boolean",
              "description": "true=按真太阳时校正（用户给具体时刻，需提供 longitude）；false=按给定时辰直接排（无需 longitude）",
              "default": true
            },
            "gregorian": {
              "type": "string",
              "format": "date-time",
              "description": "出生公历时间（Gregorian calendar，RFC3339 格式）。农历时间请自行转换为公历后传入。"
            }
          },
          "required": [
            "gregorian",
            "gender"
          ]
        },
        "result_schema": {
          "type": "object",
          "properties": {
            "solar": {
              "type": "string",
              "description": "真太阳时（correct=true 时校正后）"
            },
            "lunar": {
              "type": "object",
              "description": "农历",
              "properties": {
                "year": {
                  "type": "integer"
                },
                "month": {
                  "type": "integer"
                },
                "day": {
                  "type": "integer"
                },
                "shichen": {
                  "type": "string"
                }
              }
            },
            "chart": {
              "type": "object",
              "description": "四柱排盘（四柱+大运+性别+出生年）",
              "properties": {
                "nian": {
                  "type": "object",
                  "properties": {
                    "gan": {
                      "type": "string",
                      "description": "天干"
                    },
                    "zhi": {
                      "type": "string",
                      "description": "地支"
                    },
                    "na_yin": {
                      "type": "string",
                      "description": "纳音"
                    }
                  }
                },
                "yue": {
                  "type": "object",
                  "properties": {
                    "gan": {
                      "type": "string",
                      "description": "天干"
                    },
                    "zhi": {
                      "type": "string",
                      "description": "地支"
                    },
                    "na_yin": {
                      "type": "string",
                      "description": "纳音"
                    }
                  }
                },
                "ri": {
                  "type": "object",
                  "properties": {
                    "gan": {
                      "type": "string",
                      "description": "天干"
                    },
                    "zhi": {
                      "type": "string",
                      "description": "地支"
                    },
                    "na_yin": {
                      "type": "string",
                      "description": "纳音"
                    }
                  }
                },
                "shi": {
                  "type": "object",
                  "properties": {
                    "gan": {
                      "type": "string",
                      "description": "天干"
                    },
                    "zhi": {
                      "type": "string",
                      "description": "地支"
                    },
                    "na_yin": {
                      "type": "string",
                      "description": "纳音"
                    }
                  }
                },
                "da_yun": {
                  "type": "object",
                  "properties": {
                    "start_date": {
                      "type": "string",
                      "description": "起运公历日"
                    },
                    "direction": {
                      "type": "string",
                      "description": "顺排/逆排"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "gan": {
                            "type": "string"
                          },
                          "zhi": {
                            "type": "string"
                          },
                          "start_date": {
                            "type": "string",
                            "description": "本步起始公历日 YYYY-MM-DD"
                          },
                          "end_date": {
                            "type": "string",
                            "description": "本步末日 YYYY-MM-DD"
                          },
                          "start_year": {
                            "type": "integer",
                            "description": "本步起始公历年"
                          },
                          "end_year": {
                            "type": "integer",
                            "description": "本步结束公历年"
                          },
                          "name": {
                            "type": "string"
                          },
                          "wuxing": {
                            "type": "string"
                          },
                          "shi_shen": {
                            "type": "string"
                          }
                        }
                      },
                      "description": "每步十年（含 start_date/end_date + start_year/end_year）"
                    },
                    "current_step_index": {
                      "type": "integer",
                      "description": "当前大运索引（-1=未起运/已过完）"
                    },
                    "next_step_in_years": {
                      "type": "integer",
                      "description": "距下一大运剩余年数"
                    }
                  }
                },
                "gender": {
                  "type": "string"
                },
                "birth_year": {
                  "type": "integer"
                },
                "zi_shi_rule": {
                  "type": "string",
                  "description": "子时换日规则说明"
                }
              }
            },
            "full": {
              "type": "object",
              "description": "完整命盘扩展（十神/藏干/神煞/空亡/魁罡/三元/合会冲刑）",
              "properties": {
                "nian": {
                  "type": "object",
                  "description": "含 shi_shens/cang_gan/shen_sha/is_void/is_kui_gang"
                },
                "yue": {
                  "type": "object",
                  "description": "含 shi_shens/cang_gan（月令本气 main）/shen_sha"
                },
                "ri": {
                  "type": "object"
                },
                "shi": {
                  "type": "object"
                }
              }
            },
            "yongshen": {
              "type": "object",
              "description": "用神三派",
              "properties": {
                "fu_yi": {
                  "type": "object",
                  "properties": {
                    "qiangruo": {
                      "type": "string",
                      "enum": [
                        "身强",
                        "身弱",
                        "中和"
                      ]
                    },
                    "yong": {
                      "type": "string"
                    },
                    "xi": {
                      "type": "string"
                    },
                    "ji": {
                      "type": "string"
                    }
                  }
                },
                "tiao_hou": {
                  "type": "object",
                  "properties": {
                    "yong": {
                      "type": "string"
                    },
                    "xi": {
                      "type": "string"
                    },
                    "ji": {
                      "type": "string"
                    }
                  }
                },
                "ge_ju": {
                  "type": "object",
                  "properties": {
                    "ge_ju": {
                      "type": "string"
                    },
                    "yong": {
                      "type": "string"
                    },
                    "xi": {
                      "type": "string"
                    },
                    "ji": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "ziwei": {
              "type": "object",
              "description": "紫微十二宫",
              "properties": {
                "gong_wei": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "zhi": {
                        "type": "string"
                      },
                      "xing_yao": {
                        "type": "array"
                      }
                    }
                  }
                },
                "si_hua": {
                  "type": "object",
                  "description": "{星名: 禄/权/科/忌}"
                },
                "ju_shu": {
                  "type": "string"
                },
                "ming_gong": {
                  "type": "string"
                }
              }
            },
            "gender": {
              "type": "string",
              "description": "性别"
            },
            "ziwei_daxian": {
              "type": "array",
              "description": "紫微十年大限：公历年段、起止虚岁、大限宫位与干支",
              "items": {
                "type": "object",
                "properties": {
                  "start_year": {
                    "type": "integer"
                  },
                  "end_year": {
                    "type": "integer"
                  },
                  "qi_sui": {
                    "type": "integer"
                  },
                  "zhi_sui": {
                    "type": "integer"
                  },
                  "gong": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "gong",
                  "name",
                  "start_year",
                  "end_year",
                  "qi_sui",
                  "zhi_sui"
                ]
              },
              "minItems": 12,
              "maxItems": 12
            }
          },
          "required": [
            "solar",
            "lunar",
            "chart",
            "full",
            "yongshen",
            "ziwei",
            "ziwei_daxian",
            "gender"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "query",
        "description": "断语查询（本命域）。仅支持本命域，流年走 yearly_range；大运/大限可用 year 指定历史或未来年限运，返回附带 current_year/source。",
        "parameters": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "enum": [
                "命宫",
                "官禄",
                "财帛",
                "疾厄",
                "夫妻",
                "子女",
                "迁移",
                "田宅",
                "父母",
                "兄弟",
                "仆役",
                "福德",
                "格局",
                "大限",
                "十神",
                "旺衰",
                "用神",
                "大运",
                "合会",
                "神煞",
                "调候",
                "五行",
                "六亲",
                "出身",
                "外貌"
              ],
              "description": "命理域（紫微宫位 + 八字层次）"
            },
            "pan": {
              "type": "object",
              "description": "full_paipan 返回的完整本命盘（禁止传快照、裁剪盘或半截盘）"
            },
            "year": {
              "type": "integer",
              "minimum": 1,
              "description": "可选。仅限 rule=大运/大限：指定取哪一年的限运；省略时使用服务端当前年份。"
            }
          },
          "required": [
            "rule",
            "pan"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "yearly_range",
        "description": "批量流年分析：一次调用替代逐年排盘+查断语；单次跨度最多 120 年。返回 years、current_year 与 year_basis；精简断语含 id/领域/事件类型/时间层/事件/结论，并输出八字、紫微、合参三层。",
        "parameters": {
          "type": "object",
          "properties": {
            "pan": {
              "type": "object",
              "description": "full_paipan 返回的完整本命盘（禁止传快照、裁剪盘或半截盘）"
            },
            "start": {
              "type": "integer",
              "description": "起始年份；与 end 的含端点跨度最多 120 年"
            },
            "end": {
              "type": "integer",
              "description": "结束年份（含）；与 start 的含端点跨度最多 120 年"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "年十神",
                  "年六亲",
                  "年神煞",
                  "年用神",
                  "年旺衰",
                  "年合会",
                  "年大运",
                  "年五行",
                  "年命宫",
                  "年官禄",
                  "年财帛",
                  "年疾厄",
                  "年福德",
                  "年夫妻",
                  "年父母",
                  "年子女",
                  "yearly_marriage",
                  "yearly_family",
                  "yearly_wealth",
                  "yearly_career",
                  "yearly_health",
                  "yearly_study",
                  "yearly_zinv",
                  "yingqi",
                  "年田宅",
                  "年迁移",
                  "年兄弟",
                  "年仆役"
                ]
              },
              "description": "流年域（年十神/年官禄…）或场景别名（yearly_marriage/yingqi）；必须按用户问题显式选择"
            },
            "detail": {
              "type": "boolean",
              "description": "true=全量断语；false=精简（默认）"
            }
          },
          "required": [
            "pan",
            "start",
            "end",
            "rules"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calibrate",
        "description": "定盘校验：多个候选生日 + 人生大事 → 每候选每事件的原始断语，输出八字/紫微/合参三层；精简断语含 id 与受控事件标签。不做命中判断——信号解读由 LLM 完成。",
        "parameters": {
          "type": "object",
          "properties": {
            "candidates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "gender": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female"
                    ],
                    "description": "性别"
                  },
                  "longitude": {
                    "type": "number",
                    "description": "出生地经度。correct=true 必填；correct=false 可省略"
                  },
                  "correct": {
                    "type": "boolean",
                    "default": true,
                    "description": "true=按具体时刻真太阳时校正（需 longitude）；false=按已明确时辰直接排（无需 longitude）"
                  },
                  "label": {
                    "type": "string",
                    "description": "候选标签（如 25号/26号，必须唯一）"
                  },
                  "gregorian": {
                    "type": "string",
                    "description": "候选出生公历时间（Gregorian calendar，RFC3339）"
                  }
                },
                "required": [
                  "gregorian",
                  "gender",
                  "label"
                ]
              },
              "description": "候选出生信息列表（2-3 个，label 必须唯一）"
            },
            "events": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": {
                "type": "object",
                "properties": {
                  "year": {
                    "type": "integer",
                    "description": "事件发生年份"
                  },
                  "rule": {
                    "type": "string",
                    "enum": [
                      "年十神",
                      "年六亲",
                      "年神煞",
                      "年用神",
                      "年旺衰",
                      "年合会",
                      "年大运",
                      "年五行",
                      "年命宫",
                      "年官禄",
                      "年财帛",
                      "年疾厄",
                      "年福德",
                      "年夫妻",
                      "年父母",
                      "年子女",
                      "yearly_marriage",
                      "yearly_family",
                      "yearly_wealth",
                      "yearly_career",
                      "yearly_health",
                      "yearly_study",
                      "yearly_zinv",
                      "yingqi",
                      "年田宅",
                      "年迁移",
                      "年兄弟",
                      "年仆役"
                    ],
                    "description": "流年命理域或场景别名（yearly_* 或 yingqi）"
                  },
                  "label": {
                    "type": "string",
                    "description": "事件描述（如 感情重大问题/换工作）"
                  }
                },
                "required": [
                  "year",
                  "rule",
                  "label"
                ]
              },
              "description": "人生大事列表（3-5 件含年份）"
            },
            "detail": {
              "type": "boolean",
              "description": "true=全量断语（含依据/经典依据/机械证据 evidence）；false=精简（id+领域+事件类型+时间层+事件+结论）",
              "default": false
            }
          },
          "required": [
            "candidates",
            "events"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "bond",
        "description": "合盘：两张本命盘 → 八字合盘 + 紫微合盘，一次调用返回双盘结果。",
        "parameters": {
          "type": "object",
          "properties": {
            "pan_a": {
              "type": "object",
              "description": "甲方本命盘（full_paipan 返回）"
            },
            "pan_b": {
              "type": "object",
              "description": "乙方本命盘（full_paipan 返回）"
            }
          },
          "required": [
            "pan_a",
            "pan_b"
          ]
        }
      }
    }
  ]
}
